<%- include('../../includes/customer/head.ejs') %>
    <html lang="<%= lang %>" data-lang="<%= lang %>" data-select-option="<%= translations.selectOption %>">

    <link rel="stylesheet" href="/css/customer/technical-service.css">
    <script
        src="https://www.google.com/recaptcha/enterprise.js?render=6LemaIMrAAAAABkGmvhvmbRSO5BbXQq7AsLB7NGU"></script>
    <title>
        <%= t.pageTitle %> | DragLab
    </title>
    <meta name="description" content="<%= t.metaDescription %>">
    <meta property="og:title" content="<%= t.ogTitle %>">
    <meta property="og:description" content="<%= t.ogDescription %>">
    <meta property="og:url" content="https://www.draglab.com/<%= lang %>/WarrantyRegistration">
    <meta property="og:type" content="website">
    <meta name="twitter:title" content="<%= t.ogTitle %>">
    <meta name="twitter:description" content="<%= t.ogDescription %>">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="https://www.draglab.com/<%= lang %>/WarrantyRegistration">
    <link rel="alternate" hreflang="en" href="https://www.draglab.com/EN/WarrantyRegistration">
    <link rel="alternate" hreflang="es" href="https://www.draglab.com/ES/WarrantyRegistration">
    <link rel="alternate" hreflang="de" href="https://www.draglab.com/DE/WarrantyRegistration">
    <link rel="alternate" hreflang="x-default" href="https://www.draglab.com/EN/WarrantyRegistration">
    </head>

    <body>
        <!-- nav-bar -->
        <%- include('../../includes/customer/navbar.ejs') %>

            <!-- Thumbnail Section -->
            <div class="slide">
                <div class="slide-text">
                    <h1>
                        <%= translations.slideTitle %>
                    </h1>
                    <p>
                        <%= translations.slideSubtitle %>
                    </p>
                </div>
                <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Photo 1">
            </div>


            <section class="technical-service-intro">
                <h2>
                    Our Technical Services Include:
                </h2>
                <ul>
                    <li>
                        <h3>Installation & User Training</h3>
                        <p>
                            Our engineers will be pleased to provide you full technical support for proper installation
                            of equipment and have it operate efficiently, tailored to your own work space, including
                            initial user training.
                        </p>
                    </li>
                    <li>
                        <h3>Installation & User Training</h3>
                        <p>
                            Our engineers will be pleased to provide you full technical support for proper installation
                            of equipment and have it operate efficiently, tailored to your own work space, including
                            initial user training.
                        </p>
                    </li>
                    <li>
                        <h3>Installation & User Training</h3>
                        <p>
                            Our engineers will be pleased to provide you full technical support for proper installation
                            of equipment and have it operate efficiently, tailored to your own work space, including
                            initial user training.
                        </p>
                    </li>

                    <!-- <h2>
                        <%= t.introTitle %>
                    </h2>
                    <p>
                        <%= t.introDesc %>
                    </p> -->
                </ul>
            </section>




            <!-- Technical service form -->
            <section class="technical-service-section">
                <h2>
                    <%= translations.formTitle %>
                </h2>

                <% if (req.query.success==='true' ) { %>
                    <div class="success-message">
                        <%= translations.success %>
                    </div>

                    <% } else if (req.query.success==='false' ) { %>
                        <div class="error-message">
                            <%= translations.error %>
                        </div>
                        <% } %>

                            <form id="techServiceForm" method="POST" action="/technical-service?lang=<%= lang %>"
                                class="form-container">

                                <!-- User Info Section -->
                                <div class="form-section">
                                    <h3>
                                        <%= translations.userSectionTitle %>
                                    </h3>

                                    <div class="checkbox-group">
                                        <input type="checkbox" id="privacyPolicy" name="privacyPolicy" required>
                                        <label for="privacyPolicy">
                                            <p>
                                                <%= translations.dataLabel %> &nbsp; <a
                                                        id="highlighted-word-primary-color"
                                                        href="/<%= lang %>/PrivacyPolicy">
                                                        <%= translations.privacyPolicy %>
                                                    </a> &nbsp;
                                                    <%= translations.dataSuffix %>
                                            </p>
                                        </label>
                                    </div>

                                    <div class="checkbox-group">
                                        <p>
                                            <%= translations.infoLabel %>
                                        </p>
                                        <br>
                                        <label><input type="radio" name="infoType" value="company" autocomplete="off"
                                                required>
                                            <%= translations.company %>
                                        </label><br>
                                        <label><input type="radio" name="infoType" value="private" autocomplete="off"
                                                required>
                                            <%= translations.private %>
                                        </label>
                                    </div>

                                    <div class="form-row">
                                        <div class="two-form-group">
                                            <div class="form-group">
                                                <label for="company">
                                                    <%= translations.company %>
                                                </label>
                                                <input type="text" id="company" name="company"
                                                    placeholder="<%= translations.company %>" autocomplete="company"
                                                    required>
                                            </div>
                                            <div class="form-group">
                                                <label for="department">Department</label>
                                                <input type="text" id="department" name="department"
                                                    placeholder="Department" autocomplete="organization-title">
                                            </div>
                                        </div>

                                        <div class="form-group checkbox-group">
                                            <label>
                                                <%= translations.salutationLabel %>
                                            </label><br>
                                            <label for="salutationMrsMs"><input type="radio" id="salutationMrsMs"
                                                    name="salutation" value="Mrs/Ms" autocomplete="off" required>
                                                <%= translations.mrs %>
                                            </label><br>
                                            <label for="salutationMr"><input type="radio" id="salutationMr"
                                                    name="salutation" value="Mr" autocomplete="off" required>
                                                <%= translations.mr %>
                                            </label>
                                        </div>

                                        <div class="three-form-group">
                                            <div class="form-group">
                                                <label for="firstName">
                                                    <%= translations.firstName %>
                                                </label>
                                                <input type="text" id="firstName" name="firstName"
                                                    placeholder="<%= translations.firstName %>"
                                                    autocomplete="given-name" required>
                                            </div>
                                            <div class="form-group">
                                                <label for="lastName">
                                                    <%= translations.lastName %>
                                                </label>
                                                <input type="text" id="lastName" name="lastName"
                                                    placeholder="<%= translations.lastName %>"
                                                    autocomplete="family-name" required>
                                            </div>
                                            <div class="form-group">
                                                <label for="postalTown">
                                                    <%= translations.postalTown %>
                                                </label>
                                                <input type="text" id="postalTown" name="postalTown"
                                                    placeholder="<%= translations.postalTown %>"
                                                    autocomplete="postal-code" required>
                                            </div>
                                        </div>

                                        <div class="three-form-group">
                                            <div class="form-group">
                                                <label for="street">
                                                    <%= translations.street %>
                                                </label>
                                                <input type="text" id="street" name="street"
                                                    placeholder="<%= translations.street %>"
                                                    autocomplete="street-address">
                                            </div>
                                            <div class="form-group">
                                                <label for="country">
                                                    <%= translations.country %>
                                                </label>
                                                <input type="text" id="country" name="country"
                                                    placeholder="<%= translations.country %>"
                                                    autocomplete="country-name" required>
                                            </div>
                                            <div class="form-group">
                                                <label for="telephone">
                                                    <%= translations.telephone %>
                                                </label>
                                                <input type="text" id="telephone" name="telephone"
                                                    placeholder="<%= translations.telephone %>" autocomplete="tel"
                                                    required>
                                            </div>
                                        </div>

                                        <div class="two-form-group">
                                            <div class="form-group">
                                                <label for="telefax">
                                                    <%= translations.telefax %>
                                                </label>
                                                <input type="text" id="telefax" name="telefax"
                                                    placeholder="<%= translations.telefax %>" autocomplete="fax">
                                            </div>
                                            <div class="form-group">
                                                <label for="email">
                                                    <%= translations.email %>
                                                </label>
                                                <input type="email" id="email" name="email"
                                                    placeholder="<%= translations.email %>" autocomplete="email"
                                                    required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Technical Issue Section -->
                                <div class="form-section">
                                    <h3>
                                        <%= translations.techSectionTitle %>
                                    </h3>
                                    <div class="form-row">
                                        <div class="three-form-group">
                                            <div class="form-group">
                                                <label for="failureDate">
                                                    <%= translations.failureDate %>
                                                </label>
                                                <input type="date" id="failureDate" name="failureDate"
                                                    autocomplete="off" required>
                                            </div>
                                            <div class="form-group">
                                                <label for="deviceCategory">
                                                    <%= translations.deviceCategory %>
                                                </label>
                                                <select id="deviceCategory" name="deviceCategory" required>
                                                    <option value="">
                                                        <%= translations.selectOption %>
                                                    </option>
                                                    <% products.forEach(product=> { %>
                                                        <option value="<%= product._id %>">
                                                            <%= product.Language[lang][0]?.ProductName ||
                                                                product.Language['EN'][0]?.ProductName %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label for="deviceModel">
                                                    <%= translations.deviceModel %>
                                                </label>
                                                <select id="deviceModel" name="deviceModel" required>
                                                    <option value="">
                                                        <%= translations.selectOption %>
                                                    </option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="two-form-group">
                                            <div class="form-group">
                                                <label for="serialNo">
                                                    <%= translations.serialNo %>
                                                </label>
                                                <input type="text" id="serialNo" name="serialNo"
                                                    placeholder="<%= translations.serialNo %>" required>
                                            </div>
                                        </div>

                                        <div class="form-group note-container">
                                            <label>
                                                <%= translations.note %>
                                            </label>
                                            <textarea name="note"
                                                placeholder="<%= translations.notePlaceholder %>"></textarea>
                                        </div>
                                    </div>
                                </div>



                                <!-- Submit Button -->

                                <div class="submit-button">
                                    <button id="techServiceSubmitBtn" type="button">
                                        <%= translations.sendBtn || 'Submit' %>
                                    </button>


                                </div>


                            </form>

            </section>



            <!-- Footer -->
            <%- include('../../includes/customer/footer.ejs') %>
                <script src="/js/technical-service.js" nonce="<%= nonce %>"></script>

    </body>

    </html>