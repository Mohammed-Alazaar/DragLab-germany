
<%- include('../../includes/customer/head.ejs') %>

<link rel="stylesheet" href="/css/customer/product-details.css">

<%
  // ===== Variables (declare ONCE) =====
  const langLower = (lang || 'EN').toLowerCase();
  const localeMap = { EN:'en_US', ES:'es_ES', DE:'de_DE', TR:'tr_TR', FR:'fr_FR' };
  const hreflangMap = { EN:'en',   ES:'es',   DE:'de',   TR:'tr',   FR:'fr' };
  const allLangs = ['EN','ES','DE','TR','FR'];

  const productName = translation?.ProductName || product?.Language?.EN?.[0]?.ProductName || 'Product';
  const productDesc = translation?.ProductDesc || product?.Language?.EN?.[0]?.ProductDesc || '';
  const cleanDesc = (productDesc || '').replace(/(<([^>]+)>)/gi, '').slice(0, 160);

  const rawThumb = product?.ProductThumbnail;
  const thumbnail = rawThumb?.startsWith('http')
    ? rawThumb
    : rawThumb
      ? `https://www.drag-lab.de${rawThumb}`
      : 'https://www.drag-lab.de/assets/Imgs/logo/logo.png';

  const canonicalUrl = `https://www.drag-lab.de/${langLower}/products/${product.slug}`;
%>

<title><%= productName %> | DragLab</title>

<!-- Primary SEO -->
<meta name="description" content="<%= cleanDesc %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="<%= canonicalUrl %>">

<!-- Hreflang (adds TR/FR + x-default) -->
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/en/products/<%= product.slug %>">
<% allLangs.forEach(l => { %>
  <link rel="alternate" hreflang="<%= hreflangMap[l] %>" href="https://www.drag-lab.de/<%= hreflangMap[l] %>/products/<%= product.slug %>">
<% }) %>

<!-- Open Graph / Twitter -->
<meta property="og:locale" content="<%= localeMap[lang] || 'en_US' %>">
<% allLangs.filter(l => l !== lang).forEach(l => { %>
  <meta property="og:locale:alternate" content="<%= localeMap[l] %>">
<% }) %>
<meta property="og:type" content="product">
<meta property="og:site_name" content="DragLab">
<meta property="og:title" content="<%= productName %> | DragLab">
<meta property="og:description" content="<%= cleanDesc %>">
<meta property="og:image" content="<%= thumbnail %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= productName %> | DragLab">
<meta name="twitter:description" content="<%= cleanDesc %>">
<meta name="twitter:image" content="<%= thumbnail %>">

<!-- Structured Data: Product (no invalid "price") -->
<script type="application/ld+json">
<%
  const baseProductLd = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": productName,
    "description": cleanDesc,
    "image": thumbnail,
    "brand": { "@type": "Organization", "name": "DragLab" },
    "category": "Laboratory Equipment",
    "releaseDate": new Date(product.createdAt).toISOString(),
    "isAccessibleForFree": true,
    "inLanguage": hreflangMap[lang] || "en",
    "url": canonicalUrl
  };
%><%= JSON.stringify(baseProductLd) %>
</script>

<!-- Structured Data: Breadcrumb -->
<script type="application/ld+json">
<%= JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.drag-lab.de" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": `https://www.drag-lab.de/${langLower}/products` },
    { "@type": "ListItem", "position": 3, "name": productName, "item": canonicalUrl }
  ]
}) %>
</script>

    </head>



    <body>
      <!-- nav-bar -->

      <%- include('../../includes/customer/navbar.ejs') %>


        <!-- nav-bar -->

        <!-- Product Details -->
        <div class="slide">
          <div class="slide-text">
            <!-- <h1>Water Still Series</h1> -->
            <div class="slide-text-content">
              <h1>
                <%= translation.ProductName %> – &nbsp;
              </h1>
              <h3>
                <%= translation.ProductNameDesc %>
              </h3>
              <p>
                <%= translation.ProductDesc %>
              </p>

            </div>
            <% if (models && models.length> 0) { %>
              <a href="#target-section" class="scroll-button">View Models</a>
              <% } %>

          </div>
          <% if (product.ProductThumbnail) { %>
            <img src="<%=product.ProductThumbnail %>" alt="<%= translation.ProductName %>" loading="lazy">
            <% } %>

        </div>


        <section class="introduction-section">
          <h2>Introduction</h2>
          <div class="introduction-container">


            <div class="introduction-text">
              <h3>
                <%= translation.ProductName %> ?
              </h3>
              <p>
                <%= translation.WhyProductDesc %>
              </p>
            </div>
            <div class="introduction-img">
              <% if (product.ProductSketch) { %>
                <img src="<%=product.ProductSketch %>" alt="<%= translation.ProductName %>" loading="lazy">
                <% } %>
            </div>
          </div>
        </SECtion>



        <div class="features-wrapper">
          <h2 class="section-title">Features</h2>

          <div class="features-grid">
            <% translation.features.forEach((feature, i)=> { %>
              <div class="feature-card">
                <img class="feature-img"
                  src="<%= feature.FeatureImage || product.Language.EN[0].features[i]?.FeatureImage %>"
                  alt="<%= feature.FeatureName %>" loading="lazy">
                <div class="feature-content">
                  <h3>
                    <%= feature.FeatureName %>
                  </h3>
                  <p>
                    <%= feature.FeatureDesc %>
                  </p>
                </div>
              </div>
              <% }) %>

          </div>
        </div>






        <% if (models && models.length> 0) { %>
          <div class="models-container" id="target-section">
            <h2>Models</h2>

        <% models.forEach(model => {
  const modelLang = model.Language[lang]?.[0] || model.Language['EN']?.[0];
  const modelName = modelLang?.ModelName || 'Unnamed Model';
  const modelDesc = (modelLang?.ModelDesc || '').replace(/(<([^>]+)>)/gi, '').slice(0, 160);

  const rawPhotos = model.ModelPhotos;
  const firstPhoto = Array.isArray(rawPhotos) ? rawPhotos[0] : rawPhotos;
  const modelImage = firstPhoto?.startsWith('http')
    ? firstPhoto
    : firstPhoto
      ? `https://www.drag-lab.de${firstPhoto}`
      : thumbnail;

  const modelUrl = `https://www.drag-lab.de/${langLower}/products/${product.slug}/${model.slug}`;
%>
<script type="application/ld+json">
<%= JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProductModel",
  "name": modelName,
  "description": modelDesc,
  "image": modelImage,
  "isVariantOf": { "@type": "Product", "name": productName, "url": canonicalUrl },
  "url": modelUrl
}) %>
</script>
<% }) %>


          </div>
          <% } %>








            <!-- Footer -->

            <%- include('../../includes/customer/footer.ejs') %>


    </body>
    <%- include('../../includes/customer/script.ejs') %>


      </html>