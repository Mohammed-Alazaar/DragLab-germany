<%- include('../../includes/customer/head.ejs') %>
<title><%= pageTitle %></title>

<%
  // Safe defaults if controller didn't pass meta
  const pageDesc = (metaDescription || '').trim() || (
    lang === 'ES' ? 'Explora artículos y novedades de DragLab sobre tecnología y equipos de laboratorio.'
    : lang === 'DE' ? 'Entdecken Sie Artikel und Neuigkeiten von DragLab zu Labortechnik und -geräten.'
    : 'Explore DragLab articles and updates on laboratory equipment and technology.'
  );

  const listUrl = 'https://www.drag-lab.de/' + lang + '/Articles';

  // Helper to sanitize body -> text
  function toText(html) {
    return String(html || '')
      .replace(/<[^>]*>/g, ' ')
      .replace(/&nbsp;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }
%>

<meta name="description" content="<%= pageDesc %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<!-- Canonical & hreflang -->
<link rel="canonical" href="<%= listUrl %>">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/Articles">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/Articles">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/Articles">
<link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR/Articles">
<link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR/Articles">
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/Articles">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<meta property="og:image" content="https://www.drag-lab.de/assets/Imgs/Icons/products/ArticlesBg.webp">
<meta property="og:image:alt" content="<%= lang === 'ES' ? 'Banner de artículos DragLab' : lang === 'DE' ? 'DragLab Artikel-Banner' : lang === 'TR' ? 'DragLab Makale Başlığı' : lang === 'FR' ? 'Bannière articles DragLab' : 'DragLab Articles banner' %>">
<meta property="og:url" content="<%= listUrl %>">
<meta property="og:site_name" content="DragLab">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDesc %>">
<meta name="twitter:image" content="https://www.drag-lab.de/assets/Imgs/Icons/products/ArticlesBg.webp">

<link rel="stylesheet" href="/css/customer/Articles.css">

<!-- CollectionPage schema -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": listUrl,
  "name": pageTitle,
  "description": pageDesc,
  "url": listUrl,
  "inLanguage": (lang || 'EN').toLowerCase(),
  "isPartOf": { "@type": "WebSite", "@id": "https://www.drag-lab.de/#website", "name": "DragLab", "url": "https://www.drag-lab.de/" },
  "publisher": {
    "@type": "Organization",
    "name": "DragLab",
    "url": "https://www.drag-lab.de/",
    "logo": { "@type": "ImageObject", "url": "https://www.drag-lab.de/assets/Imgs/logo/logo.png" }
  },
  "hasPart": (articles || []).slice(0, 20).map(function(a) {
    const thumb = (a.thumbnail && a.thumbnail.startsWith('http'))
      ? a.thumbnail : (a.thumbnail ? 'https://www.drag-lab.de' + a.thumbnail : null);
    return {
      "@type": "Article",
      "name": a.title || '',
      "url": 'https://www.drag-lab.de/' + lang + '/articles/' + (a.slug || ''),
      "image": thumb || undefined,
      "datePublished": a.createdAt ? new Date(a.createdAt).toISOString() : undefined,
      "description": (a.summary && a.summary.trim()) ? a.summary.trim().slice(0, 160) : toText(a.body).slice(0, 160),
      "author": a.author ? { "@type": "Person", "name": a.author } : undefined,
      "articleSection": a.category || undefined,
      "keywords": (a.tags && a.tags.length) ? a.tags.join(', ') : undefined
    };
  })
}) %>
</script>

<!-- ItemList for Google Discover & AI -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageTitle,
  "url": listUrl,
  "numberOfItems": (articles || []).length,
  "itemListElement": (articles || []).map(function(a, idx) {
    return {
      "@type": "ListItem",
      "position": idx + 1,
      "url": 'https://www.drag-lab.de/' + lang + '/articles/' + (a.slug || ''),
      "name": a.title || ''
    };
  })
}) %>
</script>
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="slide">
    <div class="slide-text">
      <h1>
        <% if (lang === 'ES') { %>Artículos<% } else if (lang === 'DE') { %>Artikel<% } else { %>Articles<% } %>
      </h1>
      <h3>
        <% if (lang === 'ES') { %>
          Explore conocimientos, innovaciones y experiencia en tecnología de laboratorio.
        <% } else if (lang === 'DE') { %>
          Entdecken Sie Einblicke, Innovationen und Fachwissen in der Labortechnologie.
        <% } else { %>
          Explore insights, innovations, and expertise in laboratory equipment and technology.
        <% } %>
      </h3>
    </div>
    <img
      src="/assets/Imgs/Icons/products/ArticlesBg.webp"
      alt="<%= lang === 'ES' ? 'Banner de artículos' : lang === 'DE' ? 'Artikel-Banner' : 'Articles banner' %>">
  </div>

  <div class="article-slides-wrapper">
    <% if (articles && articles.length) { %>
      <% articles.forEach(function(a){ 
           const cardUrl = '/' + lang + '/articles/' + a.slug;
           const thumb = (a.thumbnail && a.thumbnail.startsWith('http'))
             ? a.thumbnail
             : (a.thumbnail ? ('https://www.drag-lab.de' + a.thumbnail) : 'https://www.drag-lab.de/assets/Imgs/logo/logo.png');
           const excerpt = (a.summary && a.summary.trim()) || toText(a.body).slice(0, 140);
      %>
        <div class="article-slide">
          <a href="<%= cardUrl %>">
            <div class="article-card">
              <img src="<%= thumb %>" alt="<%= a.title %>" loading="lazy" decoding="async">
              <div class="article-card-information">
                <h4><%= a.title %></h4>
                <p><%= excerpt %>…</p>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    <% } else { %>
      <div class="article-empty">
        <p>
          <% if (lang === 'ES') { %>
            No hay artículos disponibles todavía.
          <% } else if (lang === 'DE') { %>
            Es sind noch keine Artikel verfügbar.
          <% } else { %>
            No articles available yet.
          <% } %>
        </p>
      </div>
    <% } %>
  </div>

  <!-- Breadcrumb JSON-LD -->
  <script type="application/ld+json" nonce="<%= nonce %>">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": (lang==='EN'?'Home':lang==='ES'?'Inicio':lang==='TR'?'Ana Sayfa':lang==='FR'?'Accueil':'Startseite'), "item": "https://www.drag-lab.de/" + lang + "/" },
      { "@type": "ListItem", "position": 2, "name": (lang==='EN'?'Articles':lang==='ES'?'Artículos':lang==='TR'?'Makaleler':lang==='FR'?'Articles':'Artikel'), "item": listUrl }
    ]
  }) %>
  </script>

  <%- include('../../includes/customer/footer.ejs') %>
  <%- include('../../includes/customer/script.ejs') %>
</body>
</html>
