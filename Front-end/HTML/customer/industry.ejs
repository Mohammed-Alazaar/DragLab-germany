<%- include('../../includes/customer/head.ejs') %>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chemical Industry | NanoDrag</title>

    <link rel="stylesheet" href="/css/customer/industry.css">

    </head>

    <body>
        <%- include('../../includes/customer/navbar.ejs') %>



            <div class="slide">
                <div class="slide-text">
                    <!-- <h1>Water Still Series</h1> -->
                    <div class="slide-text-content">
                        <h1>
                            Industry solutions

                        </h1>
                        <h3>

                        </h3>
                        <p>
                            Discover how DragLab provides reliable laboratory equipment solutions for a wide range of
                            industries, from research to production. </p>

                    </div>
                    <a href="#target-section" class="scroll-button">View Industries</a>

                </div>
                <img src="/assets/Imgs/thumbnils/industry-thumbnail.webp" alt="Industry Solutions">

            </div>



            <section class="introduction-section">
                <h2>Introduction</h2>
                <div class="introduction-container">


                    <div class="introduction-text">
                        <h3>
                            Our Goal
                        </h3>
                        <p>
                            At DragLab, our goal is to empower laboratories and industries with cutting-edge equipment
                            that enhances precision, efficiency, and safety in scientific research and production
                            processes. We are committed to innovation, quality, and sustainability, providing advanced
                            solutions that support the progress of various fields, from pharmaceuticals and
                            biotechnology to food and beverage, and environmental science. By understanding the unique
                            challenges of our customers, we deliver tailored solutions that meet the highest standards
                            of performance and reliability, contributing to advancements in technology, research, and a
                            better quality of life.

                        </p>
                    </div>
                    <div class="introduction-img">
                        <img src="/assets/Imgs/thumbnils/Our-Goal.webp" alt="Our Goal">
                    </div>
                </div>
            </section>



            <section class="industries-section" id="target-section">
                <h2>
                    Industries
                </h2>

                <div class="industries-container">


                    <div class="industry-card">
                        <a href="#ChemicalIndustry">
                            <img loading="lazy" src="/assets/Imgs/Icons/products/Chemical-industry.webp"
                                alt="Chemical industry" />
                            <div class="overlay">

                                <h3>
                                    Chemical industry
                                </h3>

                            </div>
                        </a>
                    </div>
                    <div class="industry-card">
                        <a href="#FoodandBeverageIndustry">
                            <img loading="lazy" src="/assets/Imgs/Icons/products/FoodandBeverageIndustry.webp"
                                alt="Food and Beverage industry" />
                            <div class="overlay">

                                <h3>
                                    Food and Beverage Industry

                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="industry-card">
                        <a href="#BiotechnologyandLifeSciences">
                            <img loading="lazy" src="/assets/Imgs/Icons/products/BiotechnologyandLifeSciences.webp"
                                alt="Biotech industry" />
                            <div class="overlay">

                                <h3>
                                    Biotechnology and Life Sciences
                                </h3>
                            </div>
                        </a>
                    </div>
                    <div class="industry-card">
                        <a href="#PharmaceuticalIndustry">
                            <img loading="lazy" src="/assets/Imgs/Icons/products/pharmaceutical.webp"
                                alt="Pharmaceutical industry" />
                            <div class="overlay">

                                <h3>
                                    Sterilization and Cleaning.
                                </h3>
                            </div>
                        </a>
                    </div>
                </div>

            </section>



            <section class="introduction-section">
                <h2>Introduction</h2>
                <div class="introduction-container">


                    <div class="introduction-text">
                        <h3>
                            Why Industry-Specific Equipment Matters
                        </h3>
                        <p>
                            Different industries face unique challenges in their laboratory processes—whether it’s
                            precision in chemical synthesis, sterility in pharmaceuticals, or compliance in food
                            testing. At DragLab, we understand these needs and deliver tailored solutions that improve
                            safety, efficiency, and data reliability.

                        </p>
                    </div>
                    <div class="introduction-img">
                        <img src="/assets/Imgs/thumbnils/Industry-Matters.webp"
                            alt="Why Industry-Specific Equipment Matters">
                    </div>
                </div>
            </section>

            <section class="download-area">
                <div class="left-side">
                    <h2>
                        Need help selecting the right solution?
                    </h2>
                    <p>
                        Our team of specialists is ready to guide you toward the best equipment for your specific
                        application.
                    </p>

                </div>
                <div class="right-side">
                    <a href="/<%= lang %>/Contactus" class="contact-button">
                        Contact Our Experts
                    </a>
                </div>
            </section>

            <%- include('../../includes/customer/footer.ejs') %>

    </body>

    </html>