<%- include('../../includes/customer/head.ejs') %>

<%
  const langLc = (lang || 'EN').toLowerCase(); // en|es|de
  const title = (pageTitle || 'Qualifications') + ' | DragLab';
  const desc = (metaDescription || 'Company qualifications, certifications, and compliance details from DragLab.')
                .toString().replace(/<\/?[^>]+>/g,'').replace(/\s+/g,' ').trim().slice(0,160);
  const base = 'https://www.drag-lab.de';
  const canonicalUrl = `${base}/${lang}/Qualifications`;
  const ogImage = `${base}/assets/Imgs/og/downloads-og.jpg`; // replace with a real hero for this page
%>

<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">

<title><%= title %></title>
<meta name="description" content="<%= desc %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="<%= canonicalUrl %>">

<!-- hreflang -->
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/Qualifications">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/Qualifications">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/Qualifications">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/Qualifications">
<link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR/Qualifications">
<link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR/Qualifications">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="DragLab">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= desc %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:locale" content="<%= langLc==='es' ? 'es_ES' : (langLc==='de' ? 'de_DE' : 'en_US') %>">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:image:alt" content="DragLab Qualifications">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= desc %>">
<meta name="twitter:image" content="<%= ogImage %>">

<!-- JSON-LD: WebPage + Breadcrumbs -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%= JSON.stringify({
  "@context":"https://schema.org",
  "@type":"WebPage",
  "name": pageTitle || "Qualifications",
  "url": canonicalUrl,
  "inLanguage": langLc,
  "description": desc,
  "isPartOf": { "@type":"WebSite", "name":"DragLab", "url":"https://www.drag-lab.de" }
}, null, 2) %>
</script>

<script type="application/ld+json" nonce="<%= nonce %>">
<%= JSON.stringify({
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    { "@type":"ListItem", "position":1, "name": (lang==='ES'?'Inicio':(lang==='DE'?'Startseite':'Home')), "item": `https://www.drag-lab.de/${lang}` },
    { "@type":"ListItem", "position":2, "name": (pageTitle || "Qualifications"), "item": canonicalUrl }
  ]
}, null, 2) %>
</script>
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <main>
    <!-- Banner -->
    <div class="slide">
      <div class="slide-text">
        <h1><%= pageTitle %></h1>
      </div>
      <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Qualifications Header Image">
    </div>

    <!-- Content -->
    <div class="PrivacyPolicycontainer">
      <h1><%= pageTitle %></h1>
      <p><strong><%= qualificationsContent[lang].status %></strong> </p>

      <div class="contact">
        <strong>Company Info:</strong><br>
        <%- qualificationsContent[lang].contactInfo %>
      </div>

      <% qualificationsContent[lang].sections.forEach(section => { %>
        <div class="section">
          <h2><%= section.title %></h2>
          <p><%- section.body %></p>
        </div>
      <% }) %>
    </div>
  </main>

  <%- include('../../includes/customer/footer.ejs') %>
</body>

<%- include('../../includes/customer/script.ejs') %>
</html>
