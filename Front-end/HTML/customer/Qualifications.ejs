<%- include('../../includes/customer/head.ejs') %>

<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">
<meta property="og:title" content="<%= pageTitle %> | DragLab">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="https://www.draglab.com/<%= lang %>/Qualifications">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= pageTitle %> | DragLab">
<meta name="twitter:description" content="<%= metaDescription %>">
<title><%= pageTitle %> | DragLab</title>
<meta name="description" content="<%= metaDescription %>">
<link rel="canonical" href="https://www.draglab.com/<%= lang %>/Qualifications">
<link rel="alternate" hreflang="en" href="https://www.draglab.com/EN/Qualifications">
<link rel="alternate" hreflang="es" href="https://www.draglab.com/ES/Qualifications">
<link rel="alternate" hreflang="de" href="https://www.draglab.com/DE/Qualifications">
<link rel="alternate" hreflang="x-default" href="https://www.draglab.com/EN/Qualifications">
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <main>
    <!-- Banner -->
    <div class="slide">
      <div class="slide-text">
        <h1><%= pageTitle %></h1>
      </div>
      <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Qualifications Header Image">
    </div>

    <!-- Content -->
    <div class="PrivacyPolicycontainer">
      <h1><%= pageTitle %></h1>
      <p><strong><%= qualificationsContent[lang].status %></strong> </p>

      <div class="contact">
        <strong>Company Info:</strong><br>
        <%- qualificationsContent[lang].contactInfo %>
      </div>

      <% qualificationsContent[lang].sections.forEach(section => { %>
        <div class="section">
          <h2><%= section.title %></h2>
          <p><%- section.body %></p>
        </div>
      <% }) %>
    </div>
  </main>

  <%- include('../../includes/customer/footer.ejs') %>
</body>

<%- include('../../includes/customer/script.ejs') %>
</html>
