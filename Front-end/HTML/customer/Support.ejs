<%- include('../../includes/customer/head.ejs') %>

<link rel="stylesheet" href="/css/customer/Support.css">

<!-- ✅ SEO Meta Tags -->
<title><%= content.pageTitle %> | DragLab</title>
<meta name="description" content="<%= content.heroDesc %>">
<link rel="canonical" href="https://www.draglab.com/<%= lang %>/support">
<link rel="alternate" hreflang="en" href="https://www.draglab.com/EN/support">
<link rel="alternate" hreflang="es" href="https://www.draglab.com/ES/support">
<link rel="alternate" hreflang="de" href="https://www.draglab.com/DE/support">
<meta property="og:title" content="<%= content.pageTitle %> | DragLab">
<meta property="og:description" content="<%= content.heroDesc %>">
<meta property="og:url" content="https://www.draglab.com/<%= lang %>/support">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= content.pageTitle %> | DragLab">
<meta name="twitter:description" content="<%= content.heroDesc %>">

<script src="https://www.google.com/recaptcha/enterprise.js?render=6LdBFQkrAAAAALGPy8986JpxndbqzY1_6kEDxH1s"></script>

<body>
    <!-- nav-bar -->
    <%- include('../../includes/customer/navbar.ejs') %>

    <!-- Hero Slide -->
    <div class="slide">
        <div class="slide-text">
            <div class="slide-text-content">
                <h1><%= content.pageTitle %></h1>
                <p><%= content.heroDesc %></p>
            </div>
            <a href="/<%= lang %>/Contactus" class="scroll-button"><%= content.contactUs %></a>
        </div>
        <img src="/assets/Imgs/Icons/products/support.webp" alt="Support Image">
    </div>

    <!-- Qualification & Validation -->
    <section class="introduction-section">
        <div class="introduction-container">
            <div class="introduction-text">
                <h3><%= content.qualificationTitle %></h3>
                <p><%= content.qualificationDesc %></p>
                <a href="/<%= lang %>/Contactus"><%= content.qualificationCTA %></a>
            </div>
            <div class="introduction-img">
                <img src="/assets/Imgs/Icons/products/Qualification&Validation.webp" alt="Qualification Image">
            </div>
        </div>
    </section>

    <!-- Calibration & Adjustment -->
    <section class="introduction-section">
        <div class="inverse-introduction-container">
            <div class="introduction-img">
                <img src="/assets/Imgs/Icons/products/Calibration&Adjustment.webp" alt="Calibration Image">
            </div>
            <div class="introduction-text">
                <h3><%= content.calibrationTitle %></h3>
                <p><%= content.calibrationDesc %></p>
                <ul>
                    <% content.calibrationBenefits.forEach(benefit => { %>
                        <li><%= benefit %></li>
                    <% }) %>
                </ul>
                <a href="/<%= lang %>/Contactus"><%= content.calibrationCTA %></a>
            </div>
        </div>
    </section>

    <!-- Maintenance & Technical Support -->
    <section class="introduction-section">
        <div class="introduction-container">
            <div class="introduction-text">
                <h3><%= content.maintenanceTitle %></h3>
                <p><%= content.maintenanceDesc %></p>
                <ul>
                    <% content.maintenanceBenefits.forEach(benefit => { %>
                        <li><%= benefit %></li>
                    <% }) %>
                </ul>
                <a href="/<%= lang %>/technical-service"><%= content.maintenanceCTA %></a>
            </div>
            <div class="introduction-img">
                <img src="/assets/Imgs/Icons/products/Maintenance.webp" alt="Maintenance Image">
            </div>
        </div>
    </section>

    <!-- Training -->
    <section class="introduction-section">
        <div class="inverse-introduction-container">
            <div class="introduction-img">
                <img src="/assets/Imgs/Icons/products/Training.webp" alt="Training Image">
            </div>
            <div class="introduction-text">
                <h3><%= content.trainingTitle %></h3>
                <p><%= content.trainingDesc %></p>
                <ul>
                    <% content.trainingBenefits.forEach(benefit => { %>
                        <li><%= benefit %></li>
                    <% }) %>
                </ul>
                <a href="/<%= lang %>/Contactus"><%= content.trainingCTA %></a>
            </div>
        </div>
    </section>

    <!-- Download Area -->
    <section class="download-area">
        <div class="left-side">
            <h2><%= content.downloadTitle %></h2>
            <p><%= content.downloadDesc %></p>
            <a href="/<%= lang %>/Downloads"><%= content.downloadExplore %></a>
        </div>
        <div class="right-side">
            <ul>
                <% content.downloadOptions.forEach(opt => { %>
                    <li><a href="#"><%= opt %></a></li>
                <% }) %>
            </ul>
        </div>
    </section>

    <!-- Footer -->
    <%- include('../../includes/customer/footer.ejs') %>
</body>

<%- include('../../includes/customer/script.ejs') %>
