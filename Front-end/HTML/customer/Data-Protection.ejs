<%- include('../../includes/customer/head.ejs') %>
<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">
<%- include('../../includes/customer/header-end.ejs') %>

<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<link rel="canonical" href="https://yourdomain.com/<%= lang.toLowerCase() %>/dataprotection" />
<link rel="alternate" hreflang="en" href="https://yourdomain.com/en/dataprotection" />
<link rel="alternate" hreflang="de" href="https://yourdomain.com/de/dataprotection" />
<link rel="alternate" hreflang="es" href="https://yourdomain.com/es/dataprotection" />
<meta property="og:title" content="<%= ogTitle %>" />
<meta property="og:description" content="<%= ogDescription %>" />
<meta property="og:image" content="<%= ogImage %>" />
<meta property="og:url" content="https://yourdomain.com/<%= lang.toLowerCase() %>/dataprotection" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">

</head>
<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="slide">
    <div class="slide-text">
      <h1><%= sectionHeading %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Data Protection Background">
  </div>

  <div class="PrivacyPolicycontainer">
    <h1><%= sectionHeading %></h1>

    <% content.forEach(section => { %>
      <div class="section">
        <h2><%= section.title %></h2>
        <p><%= section.text %></p>
      </div>
    <% }) %>

    <div class="contact">
      <strong>Contact:</strong><br>
      <span class="highlighted">If you have any questions, please reach out at 
        <a href="mailto:info@drag-lab.de">info@drag-lab.de</a>.
      </span><br>
      <%= lang === 'DE' ? 'Ihre Privatsphäre ist uns wichtig.' : lang === 'ES' ? 'Tu privacidad es importante para nosotros.' : 'Your privacy matters to NanoDrag, and we are committed to safeguarding it.' %>
    </div>
  </div>

  <%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
</html>
