<%- include('../../includes/customer/head.ejs') %>
<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">

<%
  // Localized labels for JSON-LD
  const homeLabel = (lang==='EN'?'Home':lang==='ES'?'Inicio':'Startseite');
  const pageLabel = (lang==='EN'?'Data Protection':lang==='ES'?'Protección de Datos':'Datenschutz');
  const inLang    = (lang==='EN'?'en':lang==='ES'?'es':'de');
%>

<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">

<link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/dataprotection">
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/dataprotection">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/dataprotection">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/dataprotection">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/dataprotection">

<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDescription %>">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:image:alt" content="<%= sectionHeading %>">
<meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/dataprotection">
<meta property="og:type" content="website">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">


<!-- Breadcrumbs -->
<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name": homeLabel, "item": "https://www.drag-lab.de/" + lang + "/"},
    {"@type":"ListItem","position":2,"name": pageLabel,  "item": "https://www.drag-lab.de/" + lang + "/dataprotection"}
  ]
}) %></script>

<!-- WebPage -->
<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"WebPage",
  "name": pageLabel + " | DragLab",
  "url": "https://www.drag-lab.de/" + lang + "/dataprotection",
  "inLanguage": inLang
}) %></script>


</head>
<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="slide">
    <div class="slide-text">
      <h1><%= sectionHeading %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Data Protection Background">
  </div>

  <div class="PrivacyPolicycontainer">
    <h1><%= sectionHeading %></h1>

    <% content.forEach(section => { %>
      <div class="section">
        <h2><%= section.title %></h2>
        <p><%= section.text %></p>
      </div>
    <% }) %>

    <div class="contact">
      <strong>Contact:</strong><br>
      <span class="highlighted">If you have any questions, please reach out at 
        <a href="mailto:info@drag-lab.de">info@drag-lab.de</a>.
      </span><br>
      <%= lang === 'DE' ? 'Ihre Privatsphäre ist uns wichtig.' : lang === 'ES' ? 'Tu privacidad es importante para nosotros.' : 'Your privacy matters to NanoDrag, and we are committed to safeguarding it.' %>
    </div>
  </div>

  <%- include('../../includes/customer/footer.ejs') %>
  <%- include('../../includes/customer/script.ejs') %>
</body>
</html>
