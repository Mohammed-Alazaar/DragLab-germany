        Alfred-Herrhausen-Allee 3-5<br>
        D-65760 Eschborn<br>
        Germany<br><br>

        <strong><%= t.representedBy %>:</strong> Rassan Habbouch<br><br>

        <strong><%= t.emailGeneral %>:</strong><br>
        <span class="highlighted">
          <a href="mailto:info@drag-lab.de">info@drag-lab.de</a>
        </span><br>

        <strong><%= t.website %>:</strong><br>
        <span class="highlighted">
          <a href="https://www.drag-lab.de" target="_blank">www.drag-lab.de</a>
        </span><br><br>

        <strong><%= t.TrademarkOwnershipTitle %>:</strong>
        <strong><%= t.TrademarkOwnership %></strong><br><br>

        <strong><%= t.registrationCourt %>:</strong> Amtsgericht Frankfurt<br>
        <strong><%= t.registrationNumber %>:</strong> HRB 97258<br>
        <strong><%= t.legalForm %>:</strong> Gesellschaft mit Beschränkter Haftung (GmbH)<br>
        <strong><%= t.registrationPlace %>:</strong> Eschborn<br>
        <strong>DUNS Nummer:</strong> 312895198<br><br>

        <strong><%= t.vatHeading %>:</strong><br>
        DE815459894<br>
        <strong><%= t.taxNumber %>:</strong><br>
        040/240/00861<br><br>

        <strong><%= t.contactDetails %>:</strong><br>
        <%= t.tel %>: +49 6196 400816<br>
        <%= t.fax %>: +49 6196 400910<br>
        <%= t.emailGeneral %>: <span class="highlighted">
          <a href="mailto:info@drag-lab.de">info@drag-lab.de</a>
        </span><br>
        <%= t.website %>: <span class="highlighted">
          <a href="https://www.drag-lab.de" target="_blank">www.drag-lab.de</a>
        </span><br><br>
        <strong><%- t.Responsible %></strong><br>
