<%- include('../../includes/customer/head.ejs') %>

    <link rel="stylesheet" href="/css/customer/Home-page.css">

    <meta property="og:locale" content="<%= lang === 'EN' ? 'en_US' : lang === 'ES' ? 'es_ES' : 'de_DE' %>">

    <!-- hreflang (use .de and correct codes) -->
    <link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN">
    <link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN">
    <link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES">
    <link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE">
    <link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR">
    <link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR">

    <%
const homeTitle = lang === 'ES' ? 'DragLab – Equipos Científicos para Laboratorios Modernos'
  : lang === 'DE' ? 'DragLab – Wissenschaftliche Geräte für Moderne Labore'
  : lang === 'TR' ? 'DragLab – Modern Laboratuvarlar için Bilimsel Ekipmanlar'
  : lang === 'FR' ? 'DragLab – Équipements Scientifiques pour Laboratoires Modernes'
  : 'DragLab – Laboratory Equipment Manufacturer | Incubators, Ovens & Distillers';
const homeDesc = lang === 'ES' ? 'DragLab fabrica incubadoras, hornos de secado, baños de agua y destiladores de alta calidad para laboratorios en todo el mundo.'
  : lang === 'DE' ? 'DragLab produziert hochwertige Laborgeräte – Inkubatoren, Trockenöfen, Wasserbäder und Wasserdestillierapparate für Labore weltweit.'
  : lang === 'TR' ? 'DragLab, dünya genelindeki laboratuvarlar için yüksek kaliteli inkübatörler, etüvler, su banyoları ve su destilasyon cihazları üretmektedir.'
  : lang === 'FR' ? 'DragLab fabrique des équipements de laboratoire de haute qualité – incubateurs, étuves, bains-marie et distillateurs pour les laboratoires du monde entier.'
  : 'DragLab manufactures high-quality laboratory equipment – incubators, drying ovens, water baths and water distillers for laboratories worldwide.';
%>
<title><%= homeTitle %></title>
<meta name="description" content="<%= homeDesc %>">
<meta name="robots" content="index, follow">
<meta property="og:title" content="<%= homeTitle %>">
<meta property="og:description" content="<%= homeDesc %>">
    <meta property="og:image" content="https://www.drag-lab.de/assets/Imgs/logo/logo.png">
    <meta property="og:url" content="https://www.drag-lab.de/<%= lang %>">
    <link rel="canonical" href="https://www.drag-lab.de/<%= lang %>">

    <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DragLab",
  "url": "https://www.drag-lab.de/",
  "logo": "https://www.drag-lab.de/assets/Imgs/logo/logo.png",
  "description": "DragLab is a manufacturer of high-quality laboratory equipment including incubators, drying ovens, water baths, and water distillers for laboratories worldwide.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": "https://www.drag-lab.de/EN/contactus"
  },
  "sameAs": []
}) %>
</script>




    </head>



    <body>
        <!-- nav-bar -->
        <!-- nav-bar -->


        <%- include('../../includes/customer/navbar.ejs') %>
            <!-- nav-bar -->

            <!-- slideshow -->



            <!-- nav-bar -->

            <!-- slideshow -->

          <section id="slideshow">
  <% slides.forEach((slide, index) => { %>
    <div class="slide <%= index === 0 ? 'show' : '' %>">
      <% if (slide.image) { %>
        <% if (index === 0) { %>
          <img
            src="<%= slide.image %>"
            alt="<%= slide.title %>"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1600" height="900">
        <% } else { %>
          <img
            src="<%= slide.image %>"
            alt="<%= slide.title %>"
            decoding="async"
            fetchpriority="low"
            width="1600" height="900">
        <% } %>
      <% } %>

      <div class="slide-text">
        <h3><%= slide.title %></h3>
        <% if (slide.desc) { %><p><%= slide.desc %></p><% } %>
        <% if (slide.buttonLink && slide.buttonLabel) { %>
          <a href="<%= slide.buttonLink %>" class="slide-cta-btn"><%= slide.buttonLabel %></a>
        <% } %>
      </div>
    </div>
  <% }) %>

  <% if (slides.length > 1) { %>
  <button class="hero-arrow hero-prev" aria-label="Previous slide">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button class="hero-arrow hero-next" aria-label="Next slide">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  <% } %>

  <div class="slideshow-dots">
    <% slides.forEach((_, index) => { %>
      <button class="dot <%= index === 0 ? 'activedot' : '' %>" data-idx="<%= index %>" aria-label="Go to slide <%= index + 1 %>"></button>
    <% }) %>
  </div>
</section>

            <!-- slideshow -->

            <!-- slideshow -->




            <!-- slideshow -->
            <!-- products slideshow start -->

           <div class="slideshow-container">
  <h2><%= t.featured %></h2>
  <div class="slides-wrapper" id="slidesWrapper">
    <% products.forEach(product => { 
         const translation = product.Language[lang]?.[0] || product.Language['EN']?.[0];
         if (!translation) return; // defensive only
    %>
      <div class="product-slide">
        <a href="/<%= lang %>/products/<%= product.slug %>" class="product-card-link">
          <div class="product-card">
            <div class="product-image-wrapper">
              <img data-src="<%= product.ProductThumbnail %>" src="" alt="<%= translation.ProductName %>" decoding="async" class="img-lazy">
              <div class="product-bg-overlay"></div>
            </div>
            <div class="product-card-information">
              <h4><%= translation.ProductName %></h4>
              <p><%= translation.ProductDesc %></p>
            </div>
            <button class="article-btn">
              <%=
                lang === 'DE' ? 'Details ansehen' :
                lang === 'ES' ? 'Ver detalles' :
                lang === 'TR' ? 'Detayları Gör' :
                lang === 'FR' ? 'Voir les détails' :
                'View Details'
              %>
            </button>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

  <button class="slideshow-btn prev-btn" data-dir="-1" aria-label="<%= lang==='DE' ? 'Vorherige' : lang==='ES' ? 'Anterior' : lang==='TR' ? 'Önceki' : lang==='FR' ? 'Précédent' : 'Previous' %>">
    <img src="/assets/Imgs/Icons/right-products-arrow.png" alt="">
  </button>
  <button class="slideshow-btn next-btn" data-dir="1" aria-label="<%= lang==='DE' ? 'Nächste' : lang==='ES' ? 'Siguiente' : lang==='TR' ? 'Sonraki' : lang==='FR' ? 'Suivant' : 'Next' %>">
    <img src="/assets/Imgs/Icons/left-products-arrow.png" alt="">
  </button>
</div>





            <!-- products slideshow end -->


            <!-- industry section -->

            <section class="industries-section">
                <h2>
                    <%= t.industries %>
                </h2>

                <div class="industries-container">

                    <% industryCards.forEach(industry=> { %>
                        <div class="industry-card">
                            <a href="/<%= lang %>/industry/<%= industry.slug %>">
                                <img data-src="<%= industry.image %>" src="" alt="<%= industry.title %>" decoding="async" class="img-lazy">
                                <div class="overlay">
                                    <h3>
                                        <%= industry.title %>
                                    </h3>
                                </div>
                            </a>
                        </div>


                        <% }) %>
                </div>
            </section>
            </div>
            </section>


            <!-- industry section -->


            <!-- article slideshow -->

            <div class="article-slideshow-container" id="articleSlideshow">
                <h2>
                    <%= t.articles %>
                </h2>
                <div class="article-slides-wrapper" id="articleSlidesWrapper">
                    <% articles.forEach(article=> { %>
                        <div class="article-slide">
                            <a href="/<%= lang %>/articles/<%= article.slug %>" class="article-card">
                                <img data-src="<%= article.thumbnail %>" src="" alt="<%= article.title %>" decoding="async" class="img-lazy">
                                <div class="article-card-information">
                                    <h4>
                                        <%= article.title %>
                                    </h4>

                                </div>
                            </a>
                        </div>
                        <% }) %>
                </div>


                <button class="article-slideshow-btn article-prev-btn" data-article-dir="-1" aria-label="<%= lang==='DE' ? 'Vorheriger Artikel' : lang==='ES' ? 'Artículo anterior' : lang==='TR' ? 'Önceki makale' : lang==='FR' ? 'Article précédent' : 'Previous article' %>">
                    <img src="/assets/Imgs/Icons/right-products-arrow.png" alt="">
                </button>
                <button class="article-slideshow-btn article-next-btn" data-article-dir="1" aria-label="<%= lang==='DE' ? 'Nächster Artikel' : lang==='ES' ? 'Siguiente artículo' : lang==='TR' ? 'Sonraki makale' : lang==='FR' ? 'Article suivant' : 'Next article' %>">
                    <img src="/assets/Imgs/Icons/left-products-arrow.png" alt="">
                </button>
            </div>




            <!-- about us  -->

            <section class="about-section">
                <h2 style="text-align:center; font-size: 2rem; margin-bottom: 30px;">
                    <%= t.about %>
                </h2>
                <div class="about-container">
                    <div class="about-image" id="about-img">
                        <img src="/assets/Imgs/Icons/products/img-vision.png" alt="About Image">
                    </div>
                    <div class="about-content">
                        <div class="about-tabs">
                            <div class="about-tab active" data-tab="vision"
                                data-icon-default="/assets/Imgs/Icons/products/vision.png"
                                data-icon-active="/assets/Imgs/Icons/products/vision-active.png">
                                <img src="/assets/Imgs/Icons/products/vision-active.png" class="tab-icon"
                                    alt="<%= t.vision %>">
                                <%= t.vision %>
                            </div>
                            <div class="about-tab" data-tab="mission"
                                data-icon-default="/assets/Imgs/Icons/products/mission.png"
                                data-icon-active="/assets/Imgs/Icons/products/mission-active.png">
                                <img src="/assets/Imgs/Icons/products/mission.png" class="tab-icon"
                                    alt=" <%= t.mission %>">
                                <%= t.mission %>
                            </div>
                            <div class="about-tab" data-tab="values"
                                data-icon-default="/assets/Imgs/Icons/products/values.png"
                                data-icon-active="/assets/Imgs/Icons/products/values-active.png">
                                <img src="/assets/Imgs/Icons/products/values.png" class="tab-icon"
                                    alt="<%= t.values %>">
                                <%= t.values %>
                            </div>
                        </div>
                        <div class="about-text" id="about-text">
                            <div class="title-icon">
                                <div class="tab-icon-bg">
                                    <img  src="/assets/Imgs/Icons/products/vision-active.png"
                                        class="tab-icon" alt="<%= t.vision %>">
                                </div>
                                <h3>
                                    <%= t.tab1Title %>
                                </h3>
                            </div>

                            <h4>
                                <%= t.tab1Subtitle %>
                            </h4>
                            <p>
                                <%- t.tab1Desc %>
                            </p>
                        </div>
                    </div>
                </div>
            </section>



            <!-- about us  -->






            <%- include('../../includes/customer/footer.ejs') %>
                <script src="/js/index.js?v=1.1.0" defer></script>
                <!-- after all HTML and just before </body> -->
                <script nonce="<%= nonce %>">
                    window.tabsData = <%- JSON.stringify({
                        vision: {
                            title: t.tab1Title,
                            sectionHeading: t.tab1Title,
                            subtitle: t.tab1Subtitle,
                            desc: String(t.tab1Desc).replace(/\n/g, '<br>')
                        },
                        mission: {
                            title: t.tab2Title,
                            sectionHeading: t.tab2Title,
                            subtitle: t.tab2Subtitle,
                            desc: String(t.tab2Desc).replace(/\n/g, '<br>')
                        },
                        values: {
                            title: t.tab3Title,
                            sectionHeading: t.tab3Title,
                            subtitle: t.tab3Subtitle,
                            desc: String(t.tab3Desc).replace(/\n/g, '<br>')
                        }
                    }) %>;
                </script>


                <script src="/js/about-us.js" defer nonce="<%= nonce %>"></script>


    </body>
    <%- include('../../includes/customer/script.ejs') %>


        </html>