<%- include('../../includes/customer/head.ejs') %>

<title><%= pageTitle %></title>
<%
  // Build common URLs (match your site's uppercase language segment + route casing)
  const base = 'https://www.drag-lab.de';
  const pagePath = '/' + lang + '/CodeofEthics';
  const pageUrl = base + pagePath;

  // Fallbacks
  const desc = (metaDescription || '').trim() || (
    lang === 'ES' ? 'Código de Ética de DragLab.' :
    lang === 'DE' ? 'Verhaltenskodex von DragLab.' :
    'DragLab Code of Ethics.'
  );
  const ogTitleSafe = ogTitle || pageTitle;
  const ogDescSafe  = ogDescription || desc;
  const ogImgSafe   = (ogImage && ogImage.startsWith('http')) ? ogImage : (base + '/assets/Imgs/logo/logo.png');
%>

<meta name="description" content="<%= desc %>">

<!-- Canonical & hreflang -->
<link rel="canonical" href="<%= pageUrl %>">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/CodeofEthics">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/CodeofEthics">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/CodeofEthics">
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/CodeofEthics">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= ogTitleSafe %>">
<meta property="og:description" content="<%= ogDescSafe %>">
<meta property="og:image" content="<%= ogImgSafe %>">
<meta property="og:url" content="<%= pageUrl %>">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogTitleSafe %>">
<meta name="twitter:description" content="<%= ogDescSafe %>">
<meta name="twitter:image" content="<%= ogImgSafe %>">

<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css"><!-- single include -->

<!-- Breadcrumbs JSON-LD -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name": (lang==='EN'?'Home':lang==='ES'?'Inicio':'Startseite'), "item": base + '/' + lang + '/'},
    {"@type":"ListItem","position":2,"name": (lang==='EN'?'Code of Ethics':lang==='ES'?'Código de Ética':'Verhaltenskodex'), "item": pageUrl}
  ]
}) %>
</script>

<!-- WebPage JSON-LD -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"WebPage",
  "name": pageTitle,
  "url": pageUrl,
  "inLanguage": (lang==='EN'?'en':lang==='ES'?'es':'de'),
  "description": desc
}) %>
</script>
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="slide">
    <div class="slide-text">
      <h1><%= sectionHeading %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png"
         alt="<%= lang==='ES'?'Portada del Código de Ética':lang==='DE'?'Titelbild Verhaltenskodex':'Code of Ethics cover' %>">
  </div>

  <div class="PrivacyPolicycontainer">
    <h1><%= sectionHeading %></h1>

    <% if (sections && sections.length) { %>
      <% sections.forEach(function(section){ %>
        <div class="section">
          <% if (section.title) { %><h2><%= section.title %></h2><% } %>
          <!-- If content is trusted HTML from CMS, keep unescaped: -->
          <p><%- section.text %></p>
          <!-- If NOT trusted, use escaped: <p><%= section.text %></p> -->
        </div>
      <% }) %>
    <% } %>

    <div class="section">
      <p><strong><%= closingStatementBold %></strong><%= closingStatement %></p>
    </div>
  </div>

  <%- include('../../includes/customer/footer.ejs') %>
  <%- include('../../includes/customer/script.ejs') %>
</body>
</html>
