<%- include('../../includes/customer/head.ejs') %>

<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">

<%- include('../../includes/customer/header-end.ejs') %>

<!-- ✅ Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">

<link rel="canonical" href="https://yourdomain.com/<%= lang.toLowerCase() %>/codeofethics" />
<link rel="alternate" hreflang="en" href="https://yourdomain.com/en/codeofethics" />
<link rel="alternate" hreflang="de" href="https://yourdomain.com/de/codeofethics" />
<link rel="alternate" hreflang="es" href="https://yourdomain.com/es/codeofethics" />

<meta property="og:title" content="<%= ogTitle %>" />
<meta property="og:description" content="<%= ogDescription %>" />
<meta property="og:image" content="<%= ogImage %>" />
<meta property="og:url" content="https://yourdomain.com/<%= lang.toLowerCase() %>/codeofethics" />
<meta property="og:type" content="website" />

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">

<link rel="icon" href="/favicon.ico" type="image/x-icon" />
<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css" />
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="slide">
    <div class="slide-text">
      <h1><%= sectionHeading %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Code of Ethics Cover">
  </div>

  <div class="PrivacyPolicycontainer">
    <h1><%= sectionHeading %></h1>
    
    <% sections.forEach(section => { %>
      <div class="section">
        <% if (section.title) { %>
          <h2><%= section.title %></h2>
        <% } %>
        <p><%- section.text %></p>
      </div>
    <% }) %>

    <div class="section">
<p><strong><%= closingStatementBold %></strong><%= closingStatement %></p>
    </div>
  </div>

  <%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
</html>
