<%- include('../../includes/customer/head.ejs') %>

  <title>
    <%= article.title %> | DragLab
  </title>

  <%
  // Build a clean text fallback for description
  const plainBody = (article.body || '')
    .replace(/(<([^>]+)>)/gi, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const cleanSummary = (article.summary && article.summary.trim()) || plainBody.slice(0, 160);

  // Avoid backticks in EJS logic; build URLs with concatenation
  const articleUrl = 'https://www.drag-lab.de/' + lang + '/articles/' + article.slug;

  const absoluteThumb = (article.thumbnail && article.thumbnail.startsWith('http'))
    ? article.thumbnail
    : (article.thumbnail ? 'https://www.drag-lab.de' + article.thumbnail : 'https://www.drag-lab.de/assets/Imgs/logo/logo.png');

  const publishedISO = article.createdAt ? new Date(article.createdAt).toISOString() : '';
  const modifiedISO  = article.updatedAt ? new Date(article.updatedAt).toISOString() : publishedISO;
%>


    <meta name="description" content="<%= cleanSummary %>">
    <meta name="robots" content="index, follow">

    <!-- Canonical & hreflang -->
    <link rel="canonical" href="<%= articleUrl %>">
    <link rel="alternate" hreflang="<%= lang.toLowerCase() %>" href="<%= articleUrl %>">
    <link rel="alternate" hreflang="x-default" href="<%= articleUrl %>">

    <!-- Open Graph (Article) -->
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= article.title %>">
    <meta property="og:description" content="<%= cleanSummary %>">
    <meta property="og:image" content="<%= absoluteThumb %>">
    <meta property="og:image:alt" content="<%= article.title %>">
    <meta property="og:url" content="<%= articleUrl %>">
    <meta property="og:site_name" content="DragLab">
    <% if (publishedISO) { %>
      <meta property="article:published_time" content="<%= publishedISO %>">
      <% } %>
        <% if (modifiedISO) { %>
          <meta property="article:modified_time" content="<%= modifiedISO %>">
          <% } %>


            <!-- Twitter -->
            <meta name="twitter:card" content="summary_large_image">
            <meta name="twitter:title" content="<%= article.title %>">
            <meta name="twitter:description" content="<%= cleanSummary %>">
            <meta name="twitter:image" content="<%= absoluteThumb %>">

            <!-- Breadcrumbs -->
            <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name": (lang==='EN'?'Home':lang==='ES'?'Inicio':'Startseite'), "item": "https://www.drag-lab.de/" + lang + "/"},
    {"@type":"ListItem","position":2,"name": (lang==='EN'?'Articles':lang==='ES'?'Artículos':'Artikel'), "item": "https://www.drag-lab.de/" + lang + "/articles"},
    {"@type":"ListItem","position":3,"name": article.title, "item": articleUrl}
  ]
}) %>
</script>

            <!-- Article structured data -->
            <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {"@type":"WebPage","@id": articleUrl},
  "headline": article.title,
  "image": [absoluteThumb],
  "author": (article.author ? {"@type":"Person","name": article.author} : {"@type":"Organization","name":"DragLab"}),
  "publisher": {"@type":"Organization","name":"DragLab","logo":{"@type":"ImageObject","url":"https://www.drag-lab.de/assets/Imgs/logo/logo.png"}},
  "datePublished": publishedISO || undefined,
  "dateModified": modifiedISO || undefined,
  "inLanguage": (lang==='EN'?'en':lang==='ES'?'es':'de'),
  "description": cleanSummary,
  "articleSection": article.category || undefined,
  "keywords": (article.tags && article.tags.length ? article.tags.join(', ') : undefined)
}) %>
</script>


            <% if (article.category) { %>
              <meta property="article:section" content="<%= article.category %>">
              <% } %>
                <% if (article.tags && article.tags.length) { article.tags.forEach(function(tag){ %>
                  <meta property="article:tag" content="<%= tag %>">
                  <% }) } %>

                    <link rel="stylesheet" href="/css/customer/article-details.css">
                    </head>


                    <body>
                      <%- include('../../includes/customer/navbar.ejs') %>

                        <div class="container">
                          <article class="main-content no-reset">
                            <% if (article.thumbnail) { %>
                              <img src="<%= absoluteThumb %>" alt="<%= article.title %>">
                              <% } %>
                                <h1>
                                  <%= article.title %>
                                </h1>
                                <h2 id="authorName">
                                  <%= article.author %>
                                </h2>
                                <%- article.body %>
                          </article>

                          <section class="sidebar-container">
                            <h3>
                              <% if (lang==='EN' ) { %>Recent Articles
                                <% } else if (lang==='ES' ) { %>Artículos Recientes
                                  <% } else { %>Neueste Artikel<% } %>
                            </h3>

                            <div class="sidebar">
                              <% if (recentArticles.length> 0) { %>
                                <% recentArticles.forEach(function(item){ const rThumb=(item.thumbnail &&
                                  item.thumbnail.startsWith('http')) ? item.thumbnail : (item.thumbnail ?
                                  ('https://www.drag-lab.de' + item.thumbnail) : '/assets/Imgs/logo/logo.png' ); %>
                                  <a href="/<%= lang %>/articles/<%= item.slug %>">
                                    <div class="recent-article">
                                      <img src="<%= rThumb %>" alt="<%= item.title %>">
                                      <h4>
                                        <%= item.title %>
                                      </h4>
                                    </div>
                                  </a>
                                  <hr>
                                  <% }) %>
                                    <% } else { %>
                                      <p style="color: #666; font-style: italic; padding: 10px;">
                                        <% if (lang==='EN' ) { %>No related articles available in this language.
                                          <% } else if (lang==='ES' ) { %>No hay artículos relacionados en este idioma.
                                            <% } else { %>Keine verwandten Artikel in dieser Sprache verfügbar.<% } %>
                                      </p>
                                      <% } %>
                            </div>
                          </section>
                        </div>

                        <%- include('../../includes/customer/footer.ejs') %>
                          <%- include('../../includes/customer/script.ejs') %>
                    </body>

                    </html>