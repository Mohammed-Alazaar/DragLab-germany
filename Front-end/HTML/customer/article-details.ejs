<%- include('../../includes/customer/head.ejs') %>

<%
  const plainBody = (article.body || '')
    .replace(/(<([^>]+)>)/gi, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  const cleanSummary = (article.summary && article.summary.trim())
    ? article.summary.trim().slice(0, 160)
    : plainBody.slice(0, 160);

  const BASE = 'https://www.drag-lab.de';
  const articleUrl = BASE + '/' + lang + '/articles/' + article.slug;

  const absoluteThumb = (article.thumbnail && article.thumbnail.startsWith('http'))
    ? article.thumbnail
    : (article.thumbnail ? BASE + article.thumbnail : BASE + '/assets/Imgs/logo/logo.png');

  const publishedISO = article.publishedAt  ? new Date(article.publishedAt).toISOString()  : '';
  const modifiedISO  = article.updatedAt    ? new Date(article.updatedAt).toISOString()    : publishedISO;

  const langMap    = { EN: 'en', ES: 'es', DE: 'de', TR: 'tr', FR: 'fr' };
  const inLanguage = langMap[lang] || 'en';

  // Choose most specific Article @type
  const articleSchemaType =
    (article.category === 'Scientific' || article.category === 'Tutorials') ? 'TechArticle' :
    (article.category === 'News') ? 'NewsArticle' : 'Article';

  // Hreflang: use per-language slugs from langSlugs if available, else fall back to current slug
  const hreflangs = {};
  const allLangs = ['EN', 'ES', 'DE', 'TR', 'FR'];
  allLangs.forEach(function(l) {
    const lKey = l.toLowerCase();
    const s = (langSlugs && langSlugs[l]) ? langSlugs[l] : (lang === l ? article.slug : null);
    if (s) hreflangs[lKey] = BASE + '/' + l + '/articles/' + s;
  });

  // Reading time label (localised)
  const readLabel = lang === 'ES' ? 'min de lectura'
                  : lang === 'DE' ? 'Min. Lesezeit'
                  : lang === 'TR' ? 'dk okuma'
                  : lang === 'FR' ? 'min de lecture'
                  : 'min read';

  // Visible formatted date
  const pubDateFormatted = article.publishedAt
    ? new Date(article.publishedAt).toLocaleDateString(inLanguage + '-001'.slice(0,6), { year: 'numeric', month: 'long', day: 'numeric' })
    : '';
%>

<title><%= article.title %> | DragLab</title>

<!-- Core SEO -->
<meta name="description" content="<%= cleanSummary %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<% if (article.author) { %><meta name="author" content="<%= article.author %>"><% } %>
<% if (article.tags && article.tags.length) { %><meta name="keywords" content="<%= article.tags.join(', ') %>"><% } %>

<!-- Canonical & hreflang -->
<link rel="canonical" href="<%= articleUrl %>">
<% Object.entries(hreflangs).forEach(function([hl, url]) { %>
<link rel="alternate" hreflang="<%= hl %>" href="<%= url %>">
<% }); %>
<link rel="alternate" hreflang="x-default" href="<%= hreflangs['en'] || articleUrl %>">

<!-- LCP preload for hero image -->
<% if (article.thumbnail) { %>
<link rel="preload" as="image" href="<%= absoluteThumb %>">
<% } %>

<!-- Open Graph (Article) -->
<meta property="og:type" content="article">
<meta property="og:title" content="<%= article.title %>">
<meta property="og:description" content="<%= cleanSummary %>">
<meta property="og:image" content="<%= absoluteThumb %>">
<meta property="og:image:alt" content="<%= article.title %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="<%= articleUrl %>">
<meta property="og:site_name" content="DragLab">
<meta property="og:locale" content="<%= inLanguage %>">
<% if (article.author) { %><meta property="article:author" content="<%= article.author %>"><% } %>
<% if (publishedISO) { %><meta property="article:published_time" content="<%= publishedISO %>"><% } %>
<% if (modifiedISO)  { %><meta property="article:modified_time"  content="<%= modifiedISO %>"><% } %>
<% if (article.category) { %><meta property="article:section" content="<%= article.category %>"><% } %>
<% if (article.tags && article.tags.length) { article.tags.forEach(function(tag) { %>
<meta property="article:tag" content="<%= tag %>">
<% }); } %>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= article.title %>">
<meta name="twitter:description" content="<%= cleanSummary %>">
<meta name="twitter:image" content="<%= absoluteThumb %>">
<meta name="twitter:image:alt" content="<%= article.title %>">

<!-- Breadcrumb schema -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem", "position": 1,
      "name": (lang==='EN'?'Home':lang==='ES'?'Inicio':lang==='TR'?'Ana Sayfa':lang==='FR'?'Accueil':'Startseite'),
      "item": BASE + '/' + lang + '/'
    },
    {
      "@type": "ListItem", "position": 2,
      "name": (lang==='EN'?'Articles':lang==='ES'?'Artículos':lang==='TR'?'Makaleler':lang==='FR'?'Articles':'Artikel'),
      "item": BASE + '/' + lang + '/Articles'
    },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": articleUrl }
  ]
}) %>
</script>

<!-- Article structured data (rich + AI-readable) -->
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": articleSchemaType,
  "@id": articleUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
  "headline": article.title,
  "description": cleanSummary,
  "articleBody": article.plainBody || undefined,
  "wordCount": article.wordCount || undefined,
  "timeRequired": article.readingTimeMin ? ('PT' + article.readingTimeMin + 'M') : undefined,
  "image": {
    "@type": "ImageObject",
    "url": absoluteThumb,
    "description": article.title
  },
  "thumbnailUrl": absoluteThumb,
  "author": article.author
    ? { "@type": "Person", "name": article.author }
    : { "@type": "Organization", "name": "DragLab", "url": BASE + '/' },
  "publisher": {
    "@type": "Organization",
    "name": "DragLab",
    "url": BASE + '/',
    "logo": {
      "@type": "ImageObject",
      "url": BASE + '/assets/Imgs/logo/logo.png',
      "width": 200,
      "height": 60
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": BASE + '/' + lang + '/Articles?q={search_term_string}',
      "query-input": "required name=search_term_string"
    }
  },
  "datePublished": publishedISO || undefined,
  "dateModified":  modifiedISO  || undefined,
  "inLanguage": inLanguage,
  "url": articleUrl,
  "isPartOf": {
    "@type": "WebSite",
    "@id": BASE + '/#website',
    "name": "DragLab",
    "url": BASE + '/'
  },
  "isAccessibleForFree": true,
  "articleSection": article.category || undefined,
  "keywords": (article.tags && article.tags.length ? article.tags.join(', ') : undefined),
  "about": (article.tags && article.tags.length
    ? article.tags.map(function(t){ return { "@type": "Thing", "name": t }; })
    : undefined),
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".article-summary", ".article-meta"]
  }
}) %>
</script>

<link rel="stylesheet" href="/css/customer/article-details.css">
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <div class="container">
    <article class="main-content no-reset">
      <% if (article.thumbnail) { %>
        <img src="<%= absoluteThumb %>" alt="<%= article.title %>" fetchpriority="high" decoding="async">
      <% } %>

      <h1><%= article.title %></h1>

      <div class="article-meta">
        <% if (article.author) { %>
          <span class="article-author"><%= article.author %></span>
        <% } %>
        <% if (pubDateFormatted) { %>
          <time class="article-date" datetime="<%= publishedISO %>"><%= pubDateFormatted %></time>
        <% } %>
        <% if (article.readingTimeMin) { %>
          <span class="article-reading-time"><%= article.readingTimeMin %> <%= readLabel %></span>
        <% } %>
        <% if (article.category) { %>
          <span class="article-category"><%= article.category %></span>
        <% } %>
      </div>

      <% if (article.summary && article.summary.trim()) { %>
        <p class="article-summary"><%= article.summary %></p>
      <% } %>

      <%- article.body %>
    </article>

    <section class="sidebar-container">
      <h3>
        <% if (lang === 'EN') { %>Recent Articles
        <% } else if (lang === 'ES') { %>Artículos Recientes
        <% } else if (lang === 'TR') { %>Son Makaleler
        <% } else if (lang === 'FR') { %>Articles Récents
        <% } else { %>Neueste Artikel<% } %>
      </h3>

      <div class="sidebar">
        <% if (recentArticles.length > 0) { %>
          <% recentArticles.forEach(function(item) {
               const rThumb = (item.thumbnail && item.thumbnail.startsWith('http'))
                 ? item.thumbnail
                 : (item.thumbnail ? (BASE + item.thumbnail) : '/assets/Imgs/logo/logo.png');
          %>
            <a href="/<%= lang %>/articles/<%= item.slug %>">
              <div class="recent-article">
                <img src="<%= rThumb %>" alt="<%= item.title %>" loading="lazy" decoding="async">
                <h4><%= item.title %></h4>
              </div>
            </a>
            <hr>
          <% }); %>
        <% } else { %>
          <p style="color: #666; font-style: italic; padding: 10px;">
            <% if (lang === 'EN') { %>No related articles available in this language.
            <% } else if (lang === 'ES') { %>No hay artículos relacionados en este idioma.
            <% } else if (lang === 'TR') { %>Bu dilde ilgili makale bulunmamaktadır.
            <% } else if (lang === 'FR') { %>Aucun article asocié disponible dans cette langue.
            <% } else { %>Keine verwandten Artikel in dieser Sprache verfügbar.<% } %>
          </p>
        <% } %>
      </div>
    </section>
  </div>

  <%- include('../../includes/customer/footer.ejs') %>
  <%- include('../../includes/customer/script.ejs') %>
  <script nonce="<%= nonce %>">
    window.__articleLangSlugs = <%- JSON.stringify(langSlugs || {}) %>;
  </script>
</body>
</html>
