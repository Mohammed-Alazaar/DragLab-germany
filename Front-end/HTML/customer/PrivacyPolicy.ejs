<%- include('../../includes/customer/head.ejs') %>


    <link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">
    <meta property="og:title" content="Privacy Policy | DragLab">
    <meta property="og:description" content="Read DragLab's Privacy Policy and learn how we handle your data.">
    <meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/PrivacyPolicy">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Privacy Policy | DragLab">
    <meta name="twitter:description" content="Read DragLab's Privacy Policy and learn how we handle your data.">
    <title>
        <%= pageTitle %> | DragLab
    </title>
    <meta name="description" content="<%= metaDescription %>">
    <link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/PrivacyPolicy">
    <link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/PrivacyPolicy">
    <link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/PrivacyPolicy">
    <link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/PrivacyPolicy">
    <link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/PrivacyPolicy">
    </head>



    <body>
        <!-- nav-bar -->

        <%- include('../../includes/customer/navbar.ejs') %>


            <!-- nav-bar -->
            <main>
                <!-- contact us thumbnail  -->
                <div class="slide">
                    <div class="slide-text">
                        <h1>Privacy Policy
                        </h1>
                    </div>
                    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Photo 1">
                </div>
                <!-- contact us thumbnail  -->

                <div class="PrivacyPolicycontainer">
                    <h1>Data Protection Policy</h1>
                    <p><strong>Status:</strong> 01.01.2019</p>

                    <div class="contact">
                        <strong>Data Controller:</strong><br>
                        <%- privacyPolicyContent[lang].contactInfo %>
                    </div>

                    <% privacyPolicyContent[lang].sections.forEach(section=> { %>
                        <div class="section">
                            <h2>
                                <%= section.title %>
                            </h2>
                            <p><%- section.body %></p>
                        </div>
                        <% }) %>
                </div>



            </main>

            <!-- Footer -->

            <%- include('../../includes/customer/footer.ejs') %>


    </body>
    <%- include('../../includes/customer/script.ejs') %>


        </html>