<%- include('../../includes/customer/head.ejs') %>
<link rel="stylesheet" href="/css/customer/tearmCondition.css">

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <!-- Hero Section -->
  <div class="slide">
    <div class="slide-text">
      <h1><%= heroTitle %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Terms and Conditions">
  </div>

  <!-- Terms Section -->
  <section class="terms-container">
    <article class="terms-article">
      <% sections.forEach(section => { %>
        <h3><%= section.title %></h3>
        <p><%- section.body %></p>
      <% }); %>
    </article>
  </section>

  <%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
