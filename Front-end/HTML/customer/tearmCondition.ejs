<%- include('../../includes/customer/head.ejs') %>
<link rel="stylesheet" href="/css/customer/tearmCondition.css">
<title><%= pageTitle %> | DragLab</title>
<meta name="description" content="<%= metaDescription %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/TermCondition">
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/TermCondition">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/TermCondition">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/TermCondition">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/TermCondition">
<link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR/TermCondition">
<link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR/TermCondition">
<meta property="og:title" content="<%= pageTitle %> | DragLab">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/TermCondition">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= pageTitle %> | DragLab">
<meta name="twitter:description" content="<%= metaDescription %>">
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle + " | DragLab",
  "url": "https://www.drag-lab.de/" + lang + "/TermCondition",
  "inLanguage": (lang || "EN").toLowerCase(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": (lang==='DE'?'Startseite':lang==='ES'?'Inicio':'Home'), "item": "https://www.drag-lab.de/" + (lang||"EN").toLowerCase() },
      { "@type": "ListItem", "position": 2, "name": pageTitle, "item": "https://www.drag-lab.de/" + lang + "/TermCondition" }
    ]
  }
}) %>
</script>
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <!-- Hero Section -->
  <div class="slide">
    <div class="slide-text">
      <h1><%= heroTitle %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Terms and Conditions">
  </div>

  <!-- Terms Section -->
  <section class="terms-container">
    <article class="terms-article">
      <% sections.forEach(section => { %>
        <h3><%= section.title %></h3>
        <p><%- section.body %></p>
      <% }); %>
    </article>
  </section>

  <%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
