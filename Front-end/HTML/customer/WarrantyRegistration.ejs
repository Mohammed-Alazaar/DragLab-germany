<%- include('../../includes/customer/head.ejs') %>

    <link rel="stylesheet" href="/css/customer/WarrantyRegistration.css">
    <script
        src="https://www.google.com/recaptcha/enterprise.js?render=6LemaIMrAAAAABkGmvhvmbRSO5BbXQq7AsLB7NGU"></script>
    <title>
        <%= t.pageTitle %> | DragLab
    </title>
    <meta name="description" content="<%= t.metaDescription %>">

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content="<%= t.ogTitle %>">
    <meta property="og:description" content="<%= t.ogDescription %>">
    <meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/WarrantyRegistration">
    <meta property="og:type" content="website">

    <!-- Twitter -->
    <meta name="twitter:title" content="<%= t.ogTitle %>">
    <meta name="twitter:description" content="<%= t.ogDescription %>">
    <meta name="twitter:card" content="summary">

    <!-- Canonical & Alternate hreflang -->
    <link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/WarrantyRegistration">
    <link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/WarrantyRegistration">
    <link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/WarrantyRegistration">
    <link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/WarrantyRegistration">

    <body>
        <%- include('../../includes/customer/navbar.ejs') %>

            <div class="slide">
                <div class="slide-text">
                    <h1>
                        <%= t.heroTitle %>
                    </h1>
                    <p>
                        <%= t.heroDesc %>
                    </p>
                </div>
                <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Warranty Registration">
            </div>



            <section class="warranty-registration-section">
                <h2>
                    <%= t.formTitle %>
                </h2>

                <% if (req.query.success) { %>
                    <div class="success-message">
                        <%= t.successMessage %>
                    </div>
                    <% } else if (req.query.error) { %>
                        <div class="error-message">
                            <%= t.errorMessage %>
                        </div>
                        <% } %>


                            <form id="warranty-form" action="/submit-warranty" method="POST">


                                <div class="form-row">
                                    <div class="two-form-group">
                                        <div class="form-group">
                                            <label for="name">
                                                <%= t.name %>
                                            </label>
                                            <input type="text" id="name" name="name"
                                                placeholder="<%= t.namePlaceholder %>" required>
                                        </div>
                                        <div class="form-group">
                                            <label for="datePurchased">
                                                <%= t.datePurchased %>
                                            </label>
                                            <input type="date" id="datePurchased" name="datePurchased" required>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="email">
                                            <%= t.email %>
                                        </label>
                                        <input type="email" id="email" name="email" placeholder="Email" required>
                                    </div>
                                </div>

                                <h3>
                                    <%= t.techHeader %>
                                </h3>

                                <div class="form-row">
                                    <div class="two-form-group">
                                        <div class="form-group">
                                            <label for="deviceCategory">
                                                <%= t.deviceCategory %>
                                            </label>
                                            <select id="deviceCategory" name="deviceCategory" required>
                                                <option value="">
                                                    <%= t.select %>
                                                </option>
                                                <% products.forEach(product=> { %>
                                                    <option value="<%= product._id %>">
                                                        <%= product.Language[lang]?.[0]?.ProductName ||
                                                            product.Language['EN']?.[0]?.ProductName %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="deviceModel">
                                                <%= t.deviceModel %>
                                            </label>
                                            <select id="deviceModel" name="deviceModel" required
                                                data-default-option="<%= t.select %>">
                                                <option value="">
                                                    <%= t.select %>
                                                </option>
                                            </select>

                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="serialNo">
                                            <%= t.serialNo %>
                                        </label>
                                        <input type="text" id="serialNo" name="serialNo" placeholder="<%= t.serialNo %>"
                                            required>
                                    </div>

                                    <div class="form-group">
                                        <label for="message">
                                            <%= t.message %>
                                        </label>
                                        <textarea id="message" name="message" placeholder="<%= t.messagePlaceholder %>"
                                            rows="5"></textarea>
                                    </div>
                                </div>

                                <input type="hidden" name="lang" value="<%= lang %>">
                                <div class="checkbox-group">
                                    <input type="checkbox" name="Dataprocessing" required>
                                    <label for="Dataprocessing">
                                        <p>
                                            <%= t.dataLabel %> &nbsp; <a id="highlighted-word-primary-color"
                                                    href="/<%= lang %>/PrivacyPolicy">
                                                    <%= t.privacyPolicy %>
                                                </a> &nbsp;
                                                <%= t.dataSuffix %>
                                        </p>
                                    </label>
                                </div>

                                <div class="submit-button">
                                    <button id="submit-btn" type="button">
                                        <%= t.submit %>
                                    </button>



                                </div>
<input type="hidden" name="g-recaptcha-response" id="recaptchaToken">

                            </form>
            </section>



            <%- include('../../includes/customer/footer.ejs') %>
                <script src="/js/warranty.js" defer nonce="<%= nonce %>"></script>

    </body>

    <%- include('../../includes/customer/script.ejs') %>

        </html>