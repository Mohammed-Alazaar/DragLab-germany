<%- include('../../includes/customer/head.ejs') %>

    <link rel="stylesheet" href="/css/customer/about-us.css">
    <script
        src="https://www.google.com/recaptcha/enterprise.js?render=6LdBFQkrAAAAALGPy8986JpxndbqzY1_6kEDxH1s"></script>


        <%- include('../../includes/customer/header-end.ejs') %>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ✅ Page Title -->
  <title><%= pageTitle %></title>

  <!-- ✅ Meta Description -->
  <meta name="description" content="<%= metaDescription %>">

  <!-- ✅ Canonical and Alternate URLs for SEO -->
  <link rel="canonical" href="https://yourdomain.com/<%= lang.toLowerCase() %>/aboutus" />
  <link rel="alternate" hreflang="en" href="https://yourdomain.com/en/aboutus" />
  <link rel="alternate" hreflang="de" href="https://yourdomain.com/de/aboutus" />
  <link rel="alternate" hreflang="es" href="https://yourdomain.com/es/aboutus" />

  <!-- ✅ Open Graph Tags for Facebook / LinkedIn / WhatsApp -->
  <meta property="og:title" content="<%= ogTitle %>" />
  <meta property="og:description" content="<%= ogDescription %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:url" content="https://yourdomain.com/<%= lang.toLowerCase() %>/aboutus" />
  <meta property="og:type" content="website" />

  <!-- ✅ Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <!-- ✅ Favicon and CSS -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/css/customer/about-us.css" />
</head>

        <body>
            <!-- nav-bar -->

            <%- include('../../includes/customer/navbar.ejs') %>


                <!-- nav-bar -->

                <!-- contact us thumbnail  -->
          <div class="slide">
    <div class="slide-text">
      <h1><%= sectionHeading %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Contact Image">
  </div>

  <section class="about-section">
    <h2 style="text-align:center; font-size: 2rem; margin-bottom: 30px;"><%= sectionHeading %></h2>
    <div class="about-container">
      <div class="about-image" id="about-img">
        <img src="/assets/Imgs/Icons/products/img-vision.png" alt="About Image">
      </div>
      <div class="about-content">
        <div class="about-tabs">
          <div class="about-tab active" data-tab="vision" data-icon-default="/assets/Imgs/Icons/products/vision.png" data-icon-active="/assets/Imgs/Icons/products/vision-active.png">
            <img src="/assets/Imgs/Icons/products/vision-active.png" class="tab-icon" alt="<%= tabs.vision.title %>">  <%= tabs.vision.title %>
          </div>
          <div class="about-tab" data-tab="mission" data-icon-default="/assets/Imgs/Icons/products/mission.png" data-icon-active="/assets/Imgs/Icons/products/mission-active.png">
            <img src="/assets/Imgs/Icons/products/mission.png" class="tab-icon" alt="<%= tabs.mission.title %>"> <%= tabs.mission.title %>
          </div>
          <div class="about-tab" data-tab="values" data-icon-default="/assets/Imgs/Icons/products/values.png" data-icon-active="/assets/Imgs/Icons/products/values-active.png">
            <img src="/assets/Imgs/Icons/products/values.png" class="tab-icon" alt="<%= tabs.values.title %>"> <%= tabs.values.title %>
          </div>
        </div>
        <div class="about-text" id="about-text">
          <div class="title-icon">
            <div class="tab-icon-bg">
              <img src="/assets/Imgs/Icons/products/vision-active.png" class="tab-icon" alt="<%= tabs.vision.title %>">
            </div>
            <h3><%= tabs.vision.title %></h3>
          </div>
          <h4><%= tabs.vision.subtitle %></h4>
          <p><%- tabs.vision.desc %></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const tabsData = <%- JSON.stringify(tabs) %>;
    const tabs = document.querySelectorAll('.about-tab');
    const text = document.getElementById('about-text');
    const image = document.getElementById('about-img').querySelector('img');

    const content = {
      vision: {
        img: "/assets/Imgs/Icons/products/img-vision.png",
        icon: "/assets/Imgs/Icons/products/vision-active.png",
        title: tabsData.vision.title,
        subtitle: tabsData.vision.subtitle,
        desc: tabsData.vision.desc
      },
      mission: {
        img: "/assets/Imgs/Icons/products/img-mission.png",
        icon: "/assets/Imgs/Icons/products/mission-active.png",
        title: tabsData.mission.title,
        subtitle: tabsData.mission.subtitle,
        desc: tabsData.mission.desc
      },
      values: {
        img: "/assets/Imgs/Icons/products/img-values.png",
        icon: "/assets/Imgs/Icons/products/values-active.png",
        title: tabsData.values.title,
        subtitle: tabsData.values.subtitle,
        desc: tabsData.values.desc
      }
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelector('.about-tab.active')?.classList.remove('active');
        tab.classList.add('active');

        const iconActive = tab.getAttribute('data-icon-active');
        const key = tab.getAttribute('data-tab');
        const c = content[key];

        tab.querySelector('img').src = iconActive;
        image.src = c.img;
        text.innerHTML = `
          <div class="title-icon">
            <div class="tab-icon-bg">
              <img src="${c.icon}" class="tab-icon">
            </div>
            <h3>${c.title}</h3>
          </div>
          <h4>${c.subtitle}</h4>
          <p>${c.desc}</p>
        `;
      });
    });
  </script>

  <section class="features-section">
    <h2 class="section-title"><%= featuresTitle %></h2>
    <div class="features-container">
      <% features.slice(0, 3).forEach(feature => { %>
        <div class="feature-box">
          <img src="/assets/Imgs/Icons/products/<%= feature.icon %>" alt="<%= feature.alt %>" class="feature-icon">
          <h3 class="feature-title"><%= feature.title %></h3>
          <p class="feature-text"><%= feature.text %></p>
        </div>
      <% }) %>
    </div>
    <div class="features-container2">
      <% features.slice(3).forEach(feature => { %>
        <div class="feature-box">
          <img src="/assets/Imgs/Icons/products/<%= feature.icon %>" alt="<%= feature.alt %>" class="feature-icon">
          <h3 class="feature-title"><%= feature.title %></h3>
          <p class="feature-text"><%= feature.text %></p>
        </div>
      <% }) %>
    </div>
  </section>
                <!-- Footer -->

                <%- include('../../includes/customer/footer.ejs') %>


        </body>


            </html>