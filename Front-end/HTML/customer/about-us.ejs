<%- include('../../includes/customer/head.ejs') %>

  <link rel="stylesheet" href="/css/customer/about-us.css">
  <!-- ✅ Page Title -->
  <title>
    <%= pageTitle %>
  </title>
  
<link rel="preload"
      as="image"
      href="/assets/Imgs/hero/hero@2x.webp"
      imagesrcset="/assets/Imgs/hero/hero@1x.webp 1x, /assets/Imgs/hero/hero@2x.webp 2x"
      type="image/webp">

  <!-- ✅ Meta Description -->
  <meta name="description" content="<%= metaDescription %>">

  <!-- ✅ Canonical & Hreflang (use .de and your actual routing) -->
  <link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/aboutus" />
  <link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/aboutus" />
  <link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/aboutus" />
  <link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/aboutus" />
  <link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/aboutus" />
  <link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR/aboutus" />
  <link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR/aboutus" />

  <!-- ✅ Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= ogTitle %>" />
  <meta property="og:description" content="<%= ogDescription %>" />
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/aboutus" />
  <meta property="og:site_name" content="DragLab" />

  <!-- ✅ Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <!-- ✅ Page-level JSON-LD (Breadcrumbs + WebPage) -->
  <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": lang === "EN" ? "Home" : (lang === "ES" ? "Inicio" : "Startseite"),
      "item": `https://www.drag-lab.de/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": pageTitle,
      "item": `https://www.drag-lab.de/${lang}/aboutus`
    }
  ]
}) %>
</script>

  <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "url": `https://www.drag-lab.de/${lang}/aboutus`,
  "description": metaDescription,
  "inLanguage": lang === "EN" ? "en" : (lang === "ES" ? "es" : "de"),
  "isPartOf": {
    "@type": "WebSite",
    "name": "DragLab",
    "url": "https://www.drag-lab.de/"
  }
}) %>
</script>

  <script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DragLab",
  "url": "https://www.drag-lab.de/",
  "logo": "https://www.drag-lab.de/assets/Imgs/logo/logo.png",
  "description": "DragLab is a manufacturer of high-quality laboratory equipment including incubators, drying ovens, water baths, and water distillers.",
  "foundingDate": "2010",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": `https://www.drag-lab.de/${lang}/contactus`
  }
}) %>
</script>

  </head>

  <body>
    <!-- nav-bar -->

    <%- include('../../includes/customer/navbar.ejs') %>


      <!-- nav-bar -->

      <!-- contact us thumbnail  -->
      <div class="slide">
        <div class="slide-text">
          <h1>
            <%= sectionHeading %>
          </h1>
        </div>
        <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Contact Image">
      </div>

      <section class="about-section">
        <h2 style="text-align:center; font-size: 2rem; margin-bottom: 30px;">
          <%= sectionHeading %>
        </h2>
        <div class="about-container">
          <div class="about-image" id="about-img">
            <img src="/assets/Imgs/Icons/products/img-vision.png" alt="About Image">
          </div>
          <div class="about-content">
            <div class="about-tabs">
              <div class="about-tab active" data-tab="vision" data-icon-default="/assets/Imgs/Icons/products/vision.png"
                data-icon-active="/assets/Imgs/Icons/products/vision-active.png">
                <img src="/assets/Imgs/Icons/products/vision-active.png" class="tab-icon"
                  alt="<%= tabs.vision.title %>">
                <%= tabs.vision.title %>
              </div>
              <div class="about-tab" data-tab="mission" data-icon-default="/assets/Imgs/Icons/products/mission.png"
                data-icon-active="/assets/Imgs/Icons/products/mission-active.png">
                <img src="/assets/Imgs/Icons/products/mission.png" class="tab-icon" alt="<%= tabs.mission.title %>">
                <%= tabs.mission.title %>
              </div>
              <div class="about-tab" data-tab="values" data-icon-default="/assets/Imgs/Icons/products/values.png"
                data-icon-active="/assets/Imgs/Icons/products/values-active.png">
                <img src="/assets/Imgs/Icons/products/values.png" class="tab-icon" alt="<%= tabs.values.title %>">
                <%= tabs.values.title %>
              </div>
            </div>
            <div class="about-text" id="about-text">
              <div class="title-icon">
                <div class="tab-icon-bg">
                  <img src="/assets/Imgs/Icons/products/vision-active.png" class="tab-icon"
                    alt="<%= tabs.vision.title %>">
                </div>
                <h3>
                  <%= tabs.vision.sectionHeading %>
                </h3>
              </div>
              <h4>
                <%= tabs.vision.subtitle %>
              </h4>
              <p><%- tabs.vision.desc %></p>
            </div>
          </div>
        </div>
      </section>



      <section class="features-section">
        <h2 class="section-title">
          <%= featuresTitle %>
        </h2>
        <div class="features-container">
          <% features.slice(0, 3).forEach(feature=> { %>
            <div class="feature-box">
              <img src="/assets/Imgs/Icons/products/<%= feature.icon %>" alt="<%= feature.alt %>" class="feature-icon">
              <h3 class="feature-title">
                <%= feature.title %>
              </h3>
              <p class="feature-text">
                <%= feature.text %>
              </p>
            </div>
            <% }) %>
        </div>
        <div class="features-container2">
          <% features.slice(3).forEach(feature=> { %>
            <div class="feature-box">
              <img src="/assets/Imgs/Icons/products/<%= feature.icon %>" alt="<%= feature.alt %>" class="feature-icon">
              <h3 class="feature-title">
                <%= feature.title %>
              </h3>
              <p class="feature-text">
                <%= feature.text %>
              </p>
            </div>
            <% }) %>
        </div>
      </section>
      <!-- Footer -->

      <%- include('../../includes/customer/footer.ejs') %>

        <!-- ✅ Custom JS file -->
     <script nonce="<%= nonce %>">
  window.tabsData = <%- JSON.stringify(tabs || null) %>;
</script>




                <script src="/js/about-us.js" nonce="<%= nonce %>"></script>

  </body>

  </html>