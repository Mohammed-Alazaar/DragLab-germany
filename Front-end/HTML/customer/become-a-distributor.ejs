<!-- ── Application Form ── -->
<div class="rq-page" id="dist-form">
  <form action="/submit-distributor-application" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="lang" value="<%= lang %>">

    <!-- ① Company Information -->
    <section class="rq-section">
      <div class="rq-section-header">
        <h2><%= formTitle %></h2>
      </div>
      <div class="rq-grid">
        <div class="rq-field">
          <label for="companyName"><%= labelCompany %> <span class="rq-req">*</span></label>
          <input type="text" id="companyName" name="companyName" required autocomplete="organization">
        </div>
        <div class="rq-field">
          <label for="country"><%= labelCountry %> <span class="rq-req">*</span></label>
          <input type="text" id="country" name="country" required autocomplete="country-name">
        </div>
        <div class="rq-field">
          <label for="website"><%= labelWebsite %></label>
          <input type="url" id="website" name="website" placeholder="https://" autocomplete="url">
        </div>
        <div class="rq-field">
          <label for="companyEstablished"><%= labelEstablished %> <span class="rq-req">*</span></label>
          <input type="number" id="companyEstablished" name="companyEstablished"
            min="1900" max="<%= new Date().getFullYear() %>" placeholder="e.g. 2005" required>
        </div>
        <div class="rq-field rq-field--full">
          <label for="companyOverview"><%= labelOverview %> <span class="rq-req">*</span></label>
          <textarea id="companyOverview" name="companyOverview" required rows="4"
            placeholder="<%= overviewHint %>"></textarea>
        </div>
      </div>
    </section>

    <!-- ② Business & Distribution Capability -->
    <section class="rq-section">
      <div class="rq-section-header">
        <h2>📊 <%= lang==='DE'?'Geschäfts- & Vertriebsfähigkeit':lang==='ES'?'Capacidad de Negocio y Distribución':lang==='TR'?'İş ve Dağıtım Kapasitesi':lang==='FR'?'Capacité Commerciale et de Distribution':'Business & Distribution Capability' %></h2>
      </div>
      <div class="rq-grid">

        <!-- Current Brands -->
        <div class="rq-field">
          <label for="currentBrands"><%= labelBrands %></label>
          <input type="text" id="currentBrands" name="currentBrands">
        </div>

        <!-- Industry Focus (multi-select dropdown) -->
        <div class="rq-field">
          <label><%= labelIndustry %> <span class="rq-req">*</span></label>
          <div class="rq-multiselect" id="industryFocusDropdown">
            <button type="button" class="rq-multiselect__toggle" aria-haspopup="listbox" aria-expanded="false">
              <span class="rq-multiselect__label">—</span>
              <svg class="rq-multiselect__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </button>
            <div class="rq-multiselect__panel" hidden role="listbox" aria-multiselectable="true">
              <% industryOptions.forEach(function(opt) { %>
              <label class="rq-multiselect__option">
                <input type="checkbox" name="industryFocus" value="<%= opt %>">
                <span><%= opt %></span>
              </label>
              <% }) %>
            </div>
            <input class="rq-multiselect__validator" tabindex="-1" aria-hidden="true" required>
          </div>
        </div>

        <!-- Sales Channels (multi-select dropdown) -->
        <div class="rq-field rq-field--full">
          <label><%= labelSalesChannels %> <small class="rq-field-hint">(<%= lang==='DE'?'Mehrfachauswahl möglich':lang==='ES'?'Seleccione todos los que apliquen':lang==='TR'?'Geçerli olanları seçin':lang==='FR'?'Sélectionnez tout ce qui s\'applique':'Select all that apply' %>)</small></label>
          <div class="rq-multiselect" id="salesChannelsDropdown">
            <button type="button" class="rq-multiselect__toggle" aria-haspopup="listbox" aria-expanded="false">
              <span class="rq-multiselect__label">—</span>
              <svg class="rq-multiselect__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </button>
            <div class="rq-multiselect__panel" hidden role="listbox" aria-multiselectable="true">
              <% salesChannelOptions.forEach(function(opt) { %>
              <label class="rq-multiselect__option">
                <input type="checkbox" name="salesChannels" value="<%= opt %>">
                <span><%= opt %></span>
              </label>
              <% }) %>
            </div>
          </div>
          <input type="text" id="salesChannelsOther" name="salesChannelsOther"
            placeholder="<%= lang==='DE'?'Bitte angeben…':lang==='ES'?'Por favor especifique…':lang==='TR'?'Lütfen belirtin…':lang==='FR'?'Veuillez préciser…':'Please specify…' %>"
            style="display:none; margin-top:0.5rem;">
        </div>

        <!-- Annual Sales Volume -->
        <div class="rq-field">
          <label for="annualSalesVolume"><%= labelSalesVolume %></label>
          <input type="text" id="annualSalesVolume" name="annualSalesVolume" placeholder="e.g. €50,000 – €100,000">
        </div>

      </div>
    </section>

    <!-- ③ Market & Territory -->
    <section class="rq-section">
      <div class="rq-section-header">
        <h2>🌍 <%= lang==='DE'?'Markt & Gebiet':lang==='ES'?'Mercado y Territorio':lang==='TR'?'Pazar ve Bölge':lang==='FR'?'Marché et Territoire':'Market & Territory' %></h2>
      </div>
      <div class="rq-grid">
        <div class="rq-field">
          <label for="distributionTerritory"><%= labelTerritory %> <span class="rq-req">*</span></label>
          <input type="text" id="distributionTerritory" name="distributionTerritory" required
            placeholder="<%= territoryHint %>">
        </div>
        <div class="rq-field">
          <label for="targetMarket"><%= labelMarket %></label>
          <input type="text" id="targetMarket" name="targetMarket" placeholder="<%= marketHint %>">
        </div>
      </div>
    </section>

    <!-- ④ Supporting Documents -->
    <section class="rq-section">
      <div class="rq-section-header">
        <h2>📎 <%= lang==='DE'?'Unterstützende Dokumente':lang==='ES'?'Documentos de Apoyo':lang==='TR'?'Destekleyici Belgeler':lang==='FR'?'Documents Justificatifs':'Supporting Documents' %></h2>
      </div>
      <div class="rq-grid">
        <div class="rq-field rq-field--full">
          <label for="companyBrochure"><%= labelBrochure %></label>
          <input type="file" id="companyBrochure" name="companyBrochure" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp">
          <span class="rq-file-hint">PDF, Word or image · max 10 MB</span>
        </div>
      </div>
    </section>

    <!-- ⑤ Contact Information -->
    <section class="rq-section">
      <div class="rq-section-header">
        <h2>📞 <%= lang==='DE'?'Kontaktdaten':lang==='ES'?'Información de Contacto':lang==='TR'?'İletişim Bilgileri':lang==='FR'?'Coordonnées':'Contact Information' %></h2>
      </div>
      <div class="rq-grid">
        <div class="rq-field">
          <label for="contactName"><%= labelContact %> <span class="rq-req">*</span></label>
          <input type="text" id="contactName" name="contactName" required autocomplete="name">
        </div>
        <div class="rq-field">
          <label for="email"><%= labelEmail %> <span class="rq-req">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email">
        </div>
        <div class="rq-field">
          <label for="phone"><%= labelPhone %></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel">
        </div>
      </div>

      <p class="rq-required-note"><span class="rq-req">*</span> <%= lang==='DE'?'Pflichtfeld':lang==='ES'?'Campo obligatorio':lang==='TR'?'Zorunlu alan':lang==='FR'?'Champ obligatoire':'Required field' %></p>

      <div class="rq-submit-row">
        <button type="submit" class="rq-submit-btn"><%= btnSubmit %></button>
        <p class="rq-response-note">
          <%= lang==='DE'?'Unser Team antwortet innerhalb von 3 Werktagen.':lang==='ES'?'Nuestro equipo responderá en 3 días hábiles.':lang==='TR'?'Ekibimiz 3 iş günü içinde yanıt verecektir.':lang==='FR'?'Notre équipe vous répondra sous 3 jours ouvrés.':'Our team will respond within 3 business days.' %>
        </p>
      </div>
    </section>

  </form>
</div>

<%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
<% if (recaptchaEnabled) { %>
<script nonce="<%= nonce %>">
(function () {
  var form = document.querySelector('form[action="/submit-distributor-application"]');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    if (!form.checkValidity()) { form.reportValidity(); return; }

    if (!window.grecaptcha || !grecaptcha.enterprise) {
      alert('reCAPTCHA failed to load. Please refresh the page and try again.');
      return;
    }

    var btn = form.querySelector('button[type="submit"]');
    if (btn) btn.disabled = true;
    var fallback = setTimeout(function () { if (btn) btn.disabled = false; }, 10000);

    grecaptcha.enterprise.ready(function () {
      grecaptcha.enterprise.execute('6LemaIMrAAAAABkGmvhvmbRSO5BbXQq7AsLB7NGU', { action: 'submit' })
        .then(function (token) {
          clearTimeout(fallback);
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'g-recaptcha-response';
          input.value = token;
          form.appendChild(input);
          form.submit();
        })
        .catch(function () {
          clearTimeout(fallback);
          if (btn) btn.disabled = false;
          alert('reCAPTCHA failed. Please try again.');
        });
    });
  });
})();
</script>
<% } %>
<script nonce="<%= nonce %>">
(function () {
  var placeholder = '<%= lang==="DE"?"— Auswählen —":lang==="ES"?"— Seleccionar —":lang==="TR"?"— Seçin —":lang==="FR"?"— Sélectionner —":"— Select —" %>';

  function initWidget(widget) {
    var toggle    = widget.querySelector('.rq-multiselect__toggle');
    var panel     = widget.querySelector('.rq-multiselect__panel');
    var labelEl   = widget.querySelector('.rq-multiselect__label');
    var validator = widget.querySelector('.rq-multiselect__validator');
    var boxes     = widget.querySelectorAll('input[type="checkbox"]');
    var otherInput = widget.parentElement.querySelector('input[name="salesChannelsOther"]');

    // Init: hide via display, remove hidden attr so we control it ourselves
    panel.removeAttribute('hidden');
    panel.style.display = 'none';

    function isOpen() { return panel.style.display === 'block'; }

    function openPanel() {
      var rect = toggle.getBoundingClientRect();
      panel.style.top    = (rect.bottom + 4) + 'px';
      panel.style.left   = rect.left + 'px';
      panel.style.width  = rect.width + 'px';
      panel.style.display = 'block';
      toggle.setAttribute('aria-expanded', 'true');
    }

    function closePanel() {
      panel.style.display = 'none';
      toggle.setAttribute('aria-expanded', 'false');
    }

    function updateLabel() {
      var checked = Array.from(boxes).filter(function(b) { return b.checked; }).map(function(b) { return b.value; });
      labelEl.textContent = checked.length ? checked.join(', ') : placeholder;
      if (validator) validator.value = checked.length ? 'ok' : '';
    }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      if (isOpen()) { closePanel(); } else { openPanel(); }
    });

    panel.addEventListener('click', function (e) {
      e.stopPropagation();
    });

    boxes.forEach(function (box) {
      box.addEventListener('change', function () {
        updateLabel();
        if (otherInput) {
          var hasOther = Array.from(boxes).some(function(b) {
            return b.checked && /other|sonstiges|otro|diğer|autre/i.test(b.value);
          });
          otherInput.style.display = hasOther ? 'block' : 'none';
          otherInput.required = hasOther;
        }
      });
    });

    document.addEventListener('click', function () { closePanel(); });
    window.addEventListener('scroll', function () { if (isOpen()) openPanel(); }, true);
    window.addEventListener('resize', function () { if (isOpen()) closePanel(); });

    updateLabel();
  }

  document.querySelectorAll('.rq-multiselect').forEach(function(w) { initWidget(w); });
})();
</script>
</html>
