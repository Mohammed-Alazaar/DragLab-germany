        <h3><%= lang==='DE'?'Partnerschaft Starten':lang==='ES'?'Iniciar la Asociación':lang==='TR'?'Ortaklığa Başlayın':lang==='FR'?'Démarrer le Partenariat':'Start Partnership' %></h3>
