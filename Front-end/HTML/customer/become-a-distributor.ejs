  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('event', 'conversion', {
    send_to: 'AW-754782155/YajVCNXF95YcEMuf9OcC',
    value: 1.0,
    currency: 'EUR'
