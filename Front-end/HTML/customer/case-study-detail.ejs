<%- include('../../includes/customer/head.ejs') %>
<link rel="stylesheet" href="/css/customer/case-studies.css">
<%
  const BASE = 'https://www.drag-lab.de';
  const pageUrl = BASE + '/' + lang + '/case-studies/' + (caseStudy.slug || caseStudy._id);
%>

<title><%= pageTitle %></title>
<meta name="description" content="<%= ogDescription %>">

<link rel="canonical" href="<%= pageUrl %>">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDescription %>">
<meta property="og:url" content="<%= pageUrl %>">
<meta property="og:type" content="article">
<% if (caseStudy.thumbnail) { %>
<meta property="og:image" content="<%= caseStudy.thumbnail %>">
<% } %>

<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":(lang==='DE'?'Startseite':lang==='ES'?'Inicio':lang==='TR'?'Ana Sayfa':lang==='FR'?'Accueil':'Home'),"item": BASE + "/" + lang + "/"},
    {"@type":"ListItem","position":2,"name":(lang==='DE'?'Fallstudien':lang==='ES'?'Casos de Estudio':lang==='TR'?'Vaka Çalışmaları':lang==='FR'?'Études de Cas':'Case Studies'),"item": BASE + "/" + lang + "/case-studies"},
    {"@type":"ListItem","position":3,"name": display.title,"item": pageUrl}
  ]
}) %></script>
</head>

<body>
<%- include('../../includes/customer/navbar.ejs') %>

<!-- Hero -->
<div class="cs-detail-hero">
  <h1><%= display.title %></h1>
</div>

<!-- Detail Content -->
<div class="cs-detail-wrapper">

  <a href="/<%= lang %>/case-studies" class="cs-back-link"><%= backLink %></a>

  <!-- Meta Strip -->
  <div class="cs-meta-strip">
    <% if (caseStudy.industry) { %>
    <div class="cs-meta-item">
      <span class="cs-meta-label">Industry</span>
      <span class="cs-meta-value"><%= caseStudy.industry %></span>
    </div>
    <% } %>
    <% if (caseStudy.clientLocation) { %>
    <div class="cs-meta-item">
      <span class="cs-meta-label">Location</span>
      <span class="cs-meta-value"><%= caseStudy.clientLocation %></span>
    </div>
    <% } %>
    <% if (caseStudy.clientType) { %>
    <div class="cs-meta-item">
      <span class="cs-meta-label">Client Type</span>
      <span class="cs-meta-value"><%= caseStudy.clientType %></span>
    </div>
    <% } %>
    <% if (caseStudy.clientSize) { %>
    <div class="cs-meta-item">
      <span class="cs-meta-label">Size</span>
      <span class="cs-meta-value"><%= caseStudy.clientSize %></span>
    </div>
    <% } %>
  </div>

  <!-- Client Profile -->
  <% if (display.clientProfile) { %>
  <div class="cs-section">
    <h2 class="cs-section-title"><%= clientProfile %></h2>
    <div class="cs-section-body"><%- display.clientProfile %></div>
  </div>
  <% } %>

  <!-- Problem -->
  <% if (display.problem) { %>
  <div class="cs-section">
    <h2 class="cs-section-title"><%= problem %></h2>
    <div class="cs-section-body"><%- display.problem %></div>
  </div>
  <% } %>

  <!-- Solution -->
  <% if (display.solution) { %>
  <div class="cs-section">
    <h2 class="cs-section-title"><%= solution %></h2>
    <div class="cs-section-body"><%- display.solution %></div>
  </div>
  <% } %>

  <!-- Results -->
  <% if (display.results) { %>
  <div class="cs-section">
    <h2 class="cs-section-title"><%= results %></h2>
    <div class="cs-section-body"><%- display.results %></div>
  </div>
  <% } %>

  <!-- Products Used -->
  <% if (caseStudy.productsUsed && caseStudy.productsUsed.length > 0) { %>
  <div class="cs-section">
    <h2 class="cs-section-title"><%= productsUsed %></h2>
    <ul class="cs-products-list">
      <% caseStudy.productsUsed.forEach(p => { %>
      <li>
        <% if (p.link) { %>
        <a href="<%= p.link %>"><%= p.name %></a>
        <% } else { %>
        <a href="#"><%= p.name %></a>
        <% } %>
      </li>
      <% }) %>
    </ul>
  </div>
  <% } %>

</div>

<%- include('../../includes/customer/footer.ejs') %>
</body>
<%- include('../../includes/customer/script.ejs') %>
</html>
