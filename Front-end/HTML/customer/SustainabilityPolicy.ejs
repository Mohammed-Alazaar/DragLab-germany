<%- include('../../includes/customer/head.ejs') %>

<link rel="stylesheet" href="/css/customer/PrivacyPolicy.css">
<meta property="og:title" content="<%= pageTitle %> | DragLab">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="https://www.drag-lab.de/<%= lang %>/SustainabilityPolicy">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= pageTitle %> | DragLab">
<meta name="twitter:description" content="<%= metaDescription %>">
<title><%= pageTitle %> | DragLab</title>
<meta name="description" content="<%= metaDescription %>">
<link rel="canonical" href="https://www.drag-lab.de/<%= lang %>/SustainabilityPolicy">
<link rel="alternate" hreflang="en" href="https://www.drag-lab.de/EN/SustainabilityPolicy">
<link rel="alternate" hreflang="es" href="https://www.drag-lab.de/ES/SustainabilityPolicy">
<link rel="alternate" hreflang="de" href="https://www.drag-lab.de/DE/SustainabilityPolicy">
<link rel="alternate" hreflang="tr" href="https://www.drag-lab.de/TR/SustainabilityPolicy">
<link rel="alternate" hreflang="fr" href="https://www.drag-lab.de/FR/SustainabilityPolicy">
<link rel="alternate" hreflang="x-default" href="https://www.drag-lab.de/EN/SustainabilityPolicy">
<script type="application/ld+json" nonce="<%= nonce %>">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": (typeof pageTitle !== 'undefined' ? pageTitle : 'Sustainability Policy') + ' | DragLab',
  "url": `https://www.drag-lab.de/${lang}/SustainabilityPolicy`,
  "inLanguage": (lang || 'EN').toLowerCase(),
  "publisher": { "@type": "Organization", "name": "DragLab", "url": "https://www.drag-lab.de/" }
}) %>
</script>
</head>

<body>
  <%- include('../../includes/customer/navbar.ejs') %>

  <main>
    <!-- Thumbnail / Banner -->
    <div class="slide">
      <div class="slide-text">
        <h1><%= pageTitle %></h1>
      </div>
      <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="Sustainability Header Image">
    </div>

    <!-- Policy Content -->
    <div class="PrivacyPolicycontainer">
      <h1><%= pageTitle %></h1>
      <p><strong><%= sustainabilityPolicyContent[lang].status %></strong> </p>

      <div class="contact">
        <strong>Company Info:</strong><br>
        <%- sustainabilityPolicyContent[lang].contactInfo %>
      </div>

      <% sustainabilityPolicyContent[lang].sections.forEach(section => { %>
        <div class="section">
          <h2><%= section.title %></h2>
          <p><%- section.body %></p>
        </div>
      <% }) %>
    </div>
  </main>

  <%- include('../../includes/customer/footer.ejs') %>
</body>

<%- include('../../includes/customer/script.ejs') %>
</html>
