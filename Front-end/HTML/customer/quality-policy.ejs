<%- include('../../includes/customer/head.ejs') %>

<meta name="description" content="<%= metaDescription %>">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:description" content="<%= ogDescription %>">
<meta property="og:url" content="https://www.draglab.com/<%= lang %>/quality-policy">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= ogDescription %>">
<link rel="canonical" href="https://www.draglab.com/<%= lang %>/quality-policy">
<link rel="alternate" hreflang="en" href="https://www.draglab.com/EN/quality-policy">
<link rel="alternate" hreflang="es" href="https://www.draglab.com/ES/quality-policy">
<link rel="alternate" hreflang="de" href="https://www.draglab.com/DE/quality-policy">
<title><%= pageTitle %> | DragLab</title>

<link rel="stylesheet" href="/css/customer/quality-policy.css">
<body>
  <!-- Navbar -->
  <%- include('../../includes/customer/navbar.ejs') %>

  <!-- Hero Banner -->
  <div class="slide">
    <div class="slide-text">
      <h1><%= heroTitle %></h1>
    </div>
    <img src="/assets/Imgs/Icons/products/contactus-BC.png" alt="DragLab Quality Banner">
  </div>

  <!-- Main Content -->
  <section class="quality-policy-container">
    <div class="container-head">
      <h2><%= heading %></h2>
    </div>

    <div class="quality-policy-content">
      <p class="intro"><%- intro %></p>

      <h2><%= lang === 'EN' ? 'Key Elements of Our Quality Policy' : lang === 'ES' ? 'Elementos clave de nuestra Política de Calidad' : 'Schlüsselelemente unserer Qualitätspolitik' %></h2>

      <% sections.forEach((section) => { %>
        <div class="quality-policy-section">
          <h3><%= section.title %></h3>
          <p><%= section.body %></p>
        </div>
      <% }); %>

      <h2><%= implementationTitle %></h2>

      <ul class="quality-policy-list">
        <% implementationList.forEach(item => { %>
          <li><strong><%= item.title %></strong> <%= item.value %></li>
        <% }) %>
      </ul>

      <h2><%= commitmentTitle %></h2>
      <p><%- commitmentBody %></p>
    </div>
  </section>

  <!-- Footer -->
  <%- include('../../includes/customer/footer.ejs') %>
</body>
    <%- include('../../includes/customer/script.ejs') %>


        </html>