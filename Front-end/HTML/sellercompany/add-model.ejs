<%- include('../../includes/sellercompany/head.ejs') %>

    <link rel="stylesheet" href="/css/sellercompany/addNewModel.css">
    <script src="https://cdn.tiny.cloud/1/mtjy6djndp0eitzxztgrpeyb5j51l2d31765itt3gj45jl8c/tinymce/6/tinymce.min.js"
        referrerpolicy="origin"></script>


    <%- include('../../includes/sellercompany/head-end.ejs') %>


        <body>
            <%- include('../../includes/sellercompany/navbar-dash.ejs') %>
                <section class="sidebar-content-container">
                    <section class="sidebar-container">
                        <%- include('../../includes/sellercompany/sidebar.ejs') %>
                    </section>
                    <section class="content-container">
                        <div class="container-head">
                            <h1>
                                <% if (editing) { %> Edit Model <% } else { %> Add New Model <% } %>
                            </h1>
                        </div>

                        <div class="form-container">
                            <% if (hasError) { %>
                                <div class="alert alert-danger">
                                    <strong>Error:</strong>
                                    <%= errorMessage %>
                                        <ul>
                                            <% validationErrors.forEach(function(error) { %>
                                                <li>
                                                    <%= error.msg %>
                                                </li>
                                                <% }); %>
                                        </ul>
                                </div>
                                <% } %>


                                    <form id="modelForm" onsubmit="return validateModelForm()" action="/admin/<%= editing ? ('edit-model/' + productId + '/' + modelId) : ('add-model/' + productId) %>" method="POST" enctype="multipart/form-data">

                                        <div class="input-container">
                                            <label for="overviewThumbnail">Overview Thumbnail</label>
                                            <input type="file" name="overviewThumbnail" accept="image/*"
                                                value="<%= model?.overviewThumbnail || '' %>">
                                            <% if (model?.overviewThumbnail) { %>
                                                <img src="<%= model.overviewThumbnail %>" style="max-width: 150px;">
                                                <input type="hidden" name="oldOverviewThumbnail"
                                                    value="<%= model.overviewThumbnail %>">
                                                <% } %>
                                        </div>
                                        <div class="input-container">
                                            <label for="modelcapacity">Model Capacity</label>
                                            <textarea name="modelcapacity"
                                                class="<%= validationErrors.find(e => e.path === 'modelcapacity') ? 'is-invalid' : '' %>"><%= model?.modelcapacity || '' %></textarea>

                                            <% const capErr=validationErrors.find(e=> e.path === 'modelcapacity'); %>
                                                <% if (capErr) { %>
                                                    <div class="form-error">
                                                        <%= capErr.msg %>
                                                    </div>
                                                    <% } %>
                                        </div>



                                        <% ['EN', 'ES' , 'DE' , 'TR' , 'FR' ].forEach(lang=> { %>
                                            <div class="language-section" data-collapsible data-lang="<%= lang %>">

                                                <h3 class="language-header">
                                                    <button class="language-toggle" type="button" aria-expanded="false">
                                                        Language: <%= lang %> <span class="chev"
                                                                aria-hidden="true">▸</span>
                                                    </button>
                                                </h3>
                                                <div class="language-body">

                                                    <div class="input-container">
                                                        <label>Model Name</label>
                                                        <input type="text" name="ModelName_<%= lang %>"
                                                            class="<%= validationErrors.find(e => e.path === `ModelName_${lang}`) ? 'is-invalid' : '' %>"
                                                            value="<%= model?.Language?.[lang]?.[0]?.ModelName || '' %>">

                                                       <% const err = validationErrors.find(e => e.path === `ModelName_${lang}`); %>

                                                            <% if (err) { %>
                                                                <div class="form-error">
                                                                    <%= err.msg %>
                                                                </div>
                                                                <% } %>
                                                    </div>
                                                    <div class="input-container">
                                                        <label>Short Description</label>
                                                        <input type="text" name="ModelNameDesc_<%= lang %>"
                                                            value="<%= model?.Language?.[lang]?.[0]?.ModelNameDesc || '' %>">
                                                    </div>
                                                    <div class="input-container">
                                                        <label>Description</label>
                                                        <input type="text" name="ModelDesc_<%= lang %>"
                                                            value="<%= model?.Language?.[lang]?.[0]?.ModelDesc || '' %>">
                                                    </div>
<!-- === SEO: Tags + Meta (per language) === -->
<div class="input-container">
  <label for="Tags_<%= lang %>">Tags / Keywords (<%= lang %>)</label>
  <input
    type="text"
    id="Tags_<%= lang %>"
    name="Tags_<%= lang %>"
    class="tags-input"
    value="<%= (model?.tags?.[lang] || []).join(', ') %>"
    placeholder="distiller, 4 l/h, stainless, DF-12" />
  <small class="text-muted">Comma separated. 3–12 concise keywords.</small>
</div>

<div class="input-container">
  <label for="MetaTitle_<%= lang %>">Meta Title (optional)</label>
  <input
    type="text"
    id="MetaTitle_<%= lang %>"
    name="MetaTitle_<%= lang %>"
    value="<%= model?.meta?.[lang]?.title || '' %>"
    maxlength="60">
  <small class="text-muted">Keep under ~60 chars.</small>
</div>

<div class="input-container">
  <label for="MetaDesc_<%= lang %>">Meta Description (optional)</label>
  <input
    type="text"
    id="MetaDesc_<%= lang %>"
    name="MetaDesc_<%= lang %>"
    value="<%= model?.meta?.[lang]?.description || '' %>"
    maxlength="160">
  <small class="text-muted">Keep under ~160 chars.</small>
</div>
<!-- === /SEO === -->




                                                    <!-- Fixed Overview Inputs -->
                                                    <div class="overview-section">
                                                        <h4>Overview</h4>
                                                        <% for (let i=0; i < 4; i++) { %>
                                                            <div class="overview-item">
                                                                <input type="text"
                                                                    name="overview[<%= lang %>][<%= i %>][overviewName]"
                                                                    placeholder="Name"
                                                                    value="<%= model?.Language?.[lang]?.[0]?.overview?.[i]?.overviewName || '' %>">
                                                                <input type="text"
                                                                    name="overview[<%= lang %>][<%= i %>][overviewDesc]"
                                                                    placeholder="Description"
                                                                    value="<%= model?.Language?.[lang]?.[0]?.overview?.[i]?.overviewDesc || '' %>">

                                                                <% if (lang==='EN' ) { %>
                                                                    <% const imgPath = model?.Language?.[lang]?.[0]?.overview?.[i]?.overviewImage; %>
                                                                        <% if (imgPath) { %>
                                                                            <img src="<%= imgPath %>"
                                                                                style="max-width: 100px;">
                                                                            <input type="hidden"
                                                                                name="oldOverviewImages_<%= i %>"
                                                                                value="<%= imgPath %>">
                                                                            <% } %>
                                                                                <input type="file"
                                                                                    name="overviewImages_EN[<%= i %>]"
                                                                                    accept="image/*">
                                                                                <% } %>
                                                            </div>
                                                            <% } %>
                                                    </div>



                                                    <div class="techspec-section">
                                                        <h4>Technical Specifications</h4>
                                                        <div id="specs_<%= lang %>_container"></div>
                                                        <button type="button" class="add-spec-section"
                                                            data-lang="<%= lang %>">Add Specification Section</button>

                                                    </div>

                                                    <h4>Downloads</h4>
                                                    <div id="download_<%= lang %>_container"></div>
                                                    <button type="button" class="add-download-field"
                                                        data-lang="<%= lang %>">Add Download File</button>


                                                </div>
                                            </div>

                                            <% const isAdmin=(user && (user.role==='admin' || user.isAdmin===true)); %>

                                                <% if (isAdmin) { %>
                                                    <div class="input-container" style="margin: .5rem 0 1rem;">
                                                        <label style="display:flex; gap:.5rem; align-items:center;">
                                                            <input type="checkbox" name="publish_<%= lang %>"
                                                                <%=model?.Language?.[lang]?.[0]?.publish ? 'checked'
                                                                : '' %> />
                                                            Publish in <strong>
                                                                <%= lang %>
                                                            </strong>
                                                        </label>
                                                        <small class="text-muted">Checked = visible in navbar for this
                                                            language.</small>
                                                    </div>
                                                    <% } %>

                                                        <% }); %>

                                                        <!-- Industry Selection -->
                                                        <div class="input-container industry-checkbox-section">
                                                            <h3>Industries <small style="font-weight:normal; color:#666;">(select up to 4)</small></h3>
                                                            <% if (allIndustries && allIndustries.length) { %>
                                                                <div class="industry-checkboxes" style="display:flex; flex-wrap:wrap; gap:1rem; margin-top:.5rem;">
                                                                    <% allIndustries.forEach(function(ind) { %>
                                                                        <% const isChecked = model?.industrySlugs?.includes(ind.slug); %>
                                                                        <label class="industry-checkbox-label" style="display:flex; align-items:center; gap:.5rem; cursor:pointer; border:1px solid #ddd; border-radius:8px; padding:.5rem .75rem; background: isChecked ? '#f0f4ff' : '#fff';">
                                                                            <input type="checkbox"
                                                                                name="industrySlugs"
                                                                                value="<%= ind.slug %>"
                                                                                <%= isChecked ? 'checked' : '' %>
                                                                                class="industry-slug-checkbox">
                                                                            <% if (ind.sharedImages?.introImage) { %>
                                                                                <img src="<%= ind.sharedImages.introImage %>" alt="<%= ind.Language?.EN?.[0]?.slideTitle || ind.slug %>" style="width:50px; height:35px; object-fit:cover; border-radius:4px;">
                                                                            <% } %>
                                                                            <span><%= ind.Language?.EN?.[0]?.slideTitle || ind.slug %></span>
                                                                        </label>
                                                                    <% }); %>
                                                                </div>
                                                                <small class="text-muted" style="display:block; margin-top:.5rem;">Industries are displayed on the model page using their published images and titles.</small>
                                                            <% } else { %>
                                                                <p style="color:#888;">No published industries found. Please add industries first.</p>
                                                            <% } %>
                                                        </div>

                                                            <!-- Model Thumbnail -->
                                                            <div class="input-container">
                                                                <label>Model Thumbnail</label>
                                                                <input type="file" name="ModelThumbnail"
                                                                    accept="image/*"
                                                                    class="<%= validationErrors.find(e => e.path === 'ModelThumbnail') ? 'is-invalid' : '' %>">
                                                                <% const thumbErr=validationErrors.find(e=> e.path ===
                                                                    'ModelThumbnail'); %>
                                                                    <% if (thumbErr) { %>
                                                                        <div class="form-error">
                                                                            <%= thumbErr.msg %>
                                                                        </div>
                                                                        <% } %>
                                                                            <% if (model?.ModelThumbnail) { %>
                                                                                <img src="<%= model.ModelThumbnail %>"
                                                                                    style="max-width: 100px;">
                                                                                <input type="hidden"
                                                                                    name="oldModelThumbnail"
                                                                                    value="<%= model.ModelThumbnail %>">
                                                                                <% } %>
                                                            </div>


                                                            <!-- Model Photos -->
                                                            <div class="input-container">
                                                                <label>Model Photos</label>
                                                                <input type="file" name="ModelPhotos" multiple
                                                                    accept="image/*">
                                                                <% if (model?.ModelPhotos?.length) { %>
                                                                    <% model.ModelPhotos.forEach(photo=> { %>
                                                                        <img src="<%= photo %>"
                                                                            style="max-width: 100px;">
                                                                        <% }) %>
                                                                            <% } %>
                                                            </div>

                                                            <div class="btn-form-container">
                                                                <a href="/admin/Myproduct" class="btnBack">Cancel</a>

                                                                <% if (editing) { %>
                                                                    <button class="btnsaveaddress" type="submit"
                                                                        name="action" value="publish">Update
                                                                        Model</button>
                                                                    <% } else { %>
                                                                        <button class="btnsaveaddress" type="submit"
                                                                            name="action" value="publish">Add
                                                                            Model</button>
                                                                        <button class="btnsaveaddress" type="submit"
                                                                            name="action" value="draft">Save as
                                                                            Draft</button>
                                                                        <% } %>
                                                            </div>

                                    </form>
                        </div>
                    </section>
                </section>




            <script id="model-data" type="application/json"><%- JSON.stringify(model?.Language || {}) %></script>


                <script src="/js/add-model.js" nonce="<%= nonce %>"></script>

        </body>

        </html>