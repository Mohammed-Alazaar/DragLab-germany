<%- include('../../includes/sellercompany/head.ejs') %>
<link rel="stylesheet" href="/css/sellercompany/all-technical-service.css">

<style nonce="<%= nonce %>">
  .form-card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 2rem; }
  .form-group { margin-bottom: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .form-group label { font-size: 0.87rem; font-weight: 700; color: #2c3e50; }
  .form-group input, .form-group select, .form-group textarea {
    padding: 0.6rem 0.9rem; border: 1.5px solid #dee2e6; border-radius: 6px; font-size: 0.93rem;
    width: 100%; box-sizing: border-box; font-family: inherit; color: #2c3e50;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none; border-color: #0d3b6e;
  }
  .form-group textarea { min-height: 100px; resize: vertical; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
  @media (max-width: 700px) { .form-row, .form-row-3 { grid-template-columns: 1fr; } }
  .lang-tabs { display: flex; gap: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #dee2e6; }
  .lang-tab { padding: 0.6rem 1.2rem; cursor: pointer; font-weight: 700; font-size: 0.88rem; color: #7f8c8d; border: none; background: none; border-bottom: 3px solid transparent; margin-bottom: -2px; }
  .lang-tab.active { color: #0d3b6e; border-bottom-color: #0d3b6e; }
  .lang-panel { display: none; }
  .lang-panel.active { display: block; }
  .section-heading { font-size: 1rem; font-weight: 700; color: #0d3b6e; margin: 1.5rem 0 0.8rem; padding-bottom: 0.3rem; border-bottom: 1px solid #e4e8ef; }
  .submit-btn { padding: 0.75rem 2.5rem; background: #0d3b6e; color: #fff; border: none; border-radius: 6px; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 1.5rem; }
  .submit-btn:hover { background: #c9a227; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: #0d3b6e; font-weight: 600; text-decoration: none; }
</style>

<body>
  <%- include('../../includes/sellercompany/navbar-dash.ejs') %>

  <section class="sidebar-content-container">
    <section class="sidebar-container">
      <%- include('../../includes/sellercompany/sidebar.ejs') %>
    </section>

    <div class="article-dashboard-container">
      <a href="/admin/glossary" class="back-link">← Back to Glossary</a>
      <h1><%= editing ? 'Edit Glossary Term' : 'Add New Glossary Term' %></h1>

      <div class="form-card">
        <form action="<%= editing ? '/admin/glossary/edit/' + term._id : '/admin/glossary/add' %>" method="POST">

          <!-- English / Master Fields -->
          <div class="section-heading">Master Term (English)</div>
          <div class="form-row">
            <div class="form-group">
              <label for="term">Term (English) <span style="color:#dc3545">*</span></label>
              <input type="text" id="term" name="term" required
                     value="<%= editing && term ? term.term : '' %>"
                     placeholder="e.g. Incubation Temperature">
            </div>
            <div class="form-group">
              <label for="slug">Slug (auto-generated if empty)</label>
              <input type="text" id="slug" name="slug"
                     value="<%= editing && term ? term.slug : '' %>">
            </div>
          </div>
          <div class="form-group">
            <label for="definition">Definition (English) <span style="color:#dc3545">*</span></label>
            <textarea id="definition" name="definition" required><%= editing && term ? term.definition : '' %></textarea>
          </div>
          <div class="form-group">
            <label for="description">Extended Description / Why It Matters (English)</label>
            <textarea id="description" name="description"><%= editing && term ? term.description || '' : '' %></textarea>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label for="status">Status</label>
              <select id="status" name="status">
                <option value="draft"     <%= (editing && term && term.status === 'draft')     ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= (editing && term && term.status === 'published') ? 'selected' : '' %>>Published</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="relatedProducts">Related Products (comma-separated)</label>
            <input type="text" id="relatedProducts" name="relatedProducts"
                   value="<%= editing && term && term.relatedProducts ? term.relatedProducts.join(', ') : '' %>"
                   placeholder="e.g. DI-120, WB-100">
          </div>

          <!-- Language Tabs for Translations -->
          <div class="section-heading">Translations</div>
          <div class="lang-tabs">
            <% ['en','es','de','tr','fr'].forEach((l, idx) => { %>
            <button type="button" class="lang-tab <%= idx === 0 ? 'active' : '' %>" data-tab="gloss-tab-<%= l %>"><%= l.toUpperCase() %></button>
            <% }) %>
          </div>

          <% ['en','es','de','tr','fr'].forEach((l, idx) => {
             const tr2 = (editing && term && term.translations && term.translations[l]) ? term.translations[l] : {};
          %>
          <div class="lang-panel <%= idx === 0 ? 'active' : '' %>" id="gloss-tab-<%= l %>">
            <div class="form-group">
              <label>Term (<%= l.toUpperCase() %>)</label>
              <input type="text" name="term_<%= l %>" value="<%= tr2.term || '' %>" placeholder="Translation of term">
            </div>
            <div class="form-group">
              <label>Definition (<%= l.toUpperCase() %>)</label>
              <textarea name="definition_<%= l %>"><%= tr2.definition || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Extended Description (<%= l.toUpperCase() %>)</label>
              <textarea name="description_<%= l %>"><%= tr2.description || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Status (<%= l.toUpperCase() %>)</label>
              <select name="status_<%= l %>">
                <option value="draft"     <%= (tr2.status === 'draft' || !tr2.status) ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= tr2.status === 'published'             ? 'selected' : '' %>>Published</option>
              </select>
            </div>
          </div>
          <% }) %>

          <button type="submit" class="submit-btn"><%= editing ? 'Save Changes' : 'Add Term' %></button>
        </form>
      </div>
    </div>
  </section>

  <script nonce="<%= nonce %>">
  (function() {
    document.querySelectorAll('.lang-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.lang-tab').forEach(function(t) { t.classList.remove('active'); });
        document.querySelectorAll('.lang-panel').forEach(function(p) { p.classList.remove('active'); });
        this.classList.add('active');
        document.getElementById(this.dataset.tab).classList.add('active');
      });
    });
  })();
  </script>
</body>
