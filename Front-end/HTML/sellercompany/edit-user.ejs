<%- include('../../includes/sellercompany/head.ejs') %>
<link rel="stylesheet" href="/css/sellercompany/all-technical-service.css">

<style>
  .user-forms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 900px;
    margin-top: 8px;
  }
  @media (max-width: 768px) {
    .user-forms-grid { grid-template-columns: 1fr; }
  }

  .form-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 28px 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  .form-card h2 {
    font-size: 1.1rem;
    color: #1a1a1a;
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--primary-Color, #1a56db);
  }

  .form-group { margin-bottom: 16px; }
  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 5px;
  }
  .form-group input,
  .form-group select {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.93rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--primary-Color, #1a56db);
    box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
  }
  .form-group input.is-invalid,
  .form-group select.is-invalid {
    border-color: #dc3545;
  }

  .btn-save {
    width: 100%;
    background: var(--primary-Color, #1a56db);
    color: #fff;
    border: none;
    padding: 10px 0;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 4px;
  }
  .btn-save:hover { opacity: 0.88; }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #4b5563;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 20px;
  }
  .btn-back:hover { color: #1a1a1a; }

  .alert { padding: 12px 18px; border-radius: 6px; margin-bottom: 18px; font-size: 0.93rem; }
  .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
  .alert-error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
</style>

</head>

<body>
  <%- include('../../includes/sellercompany/navbar-dash.ejs') %>
  <section class="sidebar-content-container">
    <section class="sidebar-container">
      <%- include('../../includes/sellercompany/sidebar.ejs') %>
    </section>

    <section class="content-container">
      <a href="/admin/users" class="btn-back">&#8592; Back to Users</a>
      <h1>Edit User</h1>

      <% if (successMessage) { %>
        <div class="alert alert-success"><%= successMessage %></div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="alert alert-error"><%= errorMessage %></div>
      <% } %>

      <div class="user-forms-grid">

        <!-- ── Edit Info ── -->
        <div class="form-card">
          <h2>User Information</h2>
          <form method="POST" action="/admin/users/edit/<%= targetUser._id %>">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" name="name" id="name"
                     class="<%= validationErrors && validationErrors.find(e => e.path === 'name') ? 'is-invalid' : '' %>"
                     value="<%= targetUser.name %>" required>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" name="email" id="email"
                     class="<%= validationErrors && validationErrors.find(e => e.path === 'email') ? 'is-invalid' : '' %>"
                     value="<%= targetUser.email %>" required>
            </div>
            <div class="form-group">
              <label for="phoneNumber">Phone Number</label>
              <input type="tel" name="phoneNumber" id="phoneNumber"
                     value="<%= targetUser.phoneNumber %>" required>
            </div>
            <div class="form-group">
              <label for="role">Role</label>
              <select name="role" id="role">
                <option value="subAdmin" <%= targetUser.role === 'subAdmin' ? 'selected' : '' %>>Sub Admin</option>
                <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select>
            </div>
            <button type="submit" class="btn-save">Save Changes</button>
          </form>
        </div>

        <!-- ── Change Password ── -->
        <div class="form-card">
          <h2>Change Password</h2>
          <form method="POST" action="/admin/users/change-password/<%= targetUser._id %>">
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <input type="password" name="newPassword" id="newPassword"
                     placeholder="Min. 8 characters" required minlength="8">
            </div>
            <div class="form-group">
              <label for="confirmNewPassword">Confirm New Password</label>
              <input type="password" name="confirmNewPassword" id="confirmNewPassword"
                     placeholder="Repeat new password" required minlength="8">
            </div>
            <button type="submit" class="btn-save" style="background:#059669;">Set New Password</button>
          </form>
        </div>

      </div>
    </section>
  </section>
</body>
</html>
