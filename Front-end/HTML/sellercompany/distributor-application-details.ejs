<%- include('../../includes/sellercompany/head.ejs') %>
<link rel="stylesheet" href="/css/sellercompany/all-technical-service.css">

<style nonce="<%= nonce %>">
  .detail-card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 2rem; margin-bottom: 1.5rem; }
  .detail-card h2 { font-size: 1.1rem; font-weight: 700; color: #0d3b6e; border-bottom: 2px solid #e4e8ef; padding-bottom: 0.5rem; margin-bottom: 1.2rem; }
  .detail-row { display: flex; gap: 2rem; margin-bottom: 0.8rem; flex-wrap: wrap; }
  .detail-field { flex: 1; min-width: 180px; }
  .detail-label { font-size: 0.78rem; font-weight: 700; color: #7f8c8d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.2rem; }
  .detail-value { font-size: 0.97rem; color: #2c3e50; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: #0d3b6e; font-weight: 600; text-decoration: none; }
  .back-link:hover { color: #c9a227; }
  .status-form { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .status-select { padding: 0.5rem 1rem; border: 2px solid #dee2e6; border-radius: 6px; font-size: 0.9rem; }
  .status-btn { padding: 0.5rem 1.5rem; background: #0d3b6e; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; }
  .status-btn:hover { background: #c9a227; }
  .status-badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
  .status-new { background: #cfe2ff; color: #084298; }
  .status-under_review { background: #fff3cd; color: #664d03; }
  .status-accepted { background: #d1e7dd; color: #0f5132; }
  .status-rejected { background: #f8d7da; color: #842029; }
  .pdf-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.4rem; background: #fff; color: #0d3b6e; border: 2px solid #0d3b6e; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: all 0.2s; }
  .pdf-btn:hover { background: #0d3b6e; color: #fff; }
  .page-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
</style>

<body>
  <%- include('../../includes/sellercompany/navbar-dash.ejs') %>

  <section class="sidebar-content-container">
    <section class="sidebar-container">
      <%- include('../../includes/sellercompany/sidebar.ejs') %>
    </section>

    <div class="article-dashboard-container">
      <div class="page-actions">
        <a href="/admin/distributor-applications" class="back-link" style="margin-bottom:0">← Back to Applications</a>
        <a href="/admin/distributor-applications/<%= application._id %>/pdf" class="pdf-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
            <path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.697 19.697 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a10.954 10.954 0 0 0 .98 1.686 5.753 5.753 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.856.856 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.712 5.712 0 0 1-.911-.95 11.651 11.651 0 0 0-1.997.406 11.307 11.307 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.793.793 0 0 1-.58.029zm1.379-1.901c-.166.076-.32.156-.459.238-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361.01.022.02.036.026.044a.266.266 0 0 0 .035-.012c.137-.056.355-.235.635-.572a8.18 8.18 0 0 0 .45-.606zm1.64-1.33a12.71 12.71 0 0 1 1.01-.193 11.744 11.744 0 0 1-.51-.858 20.801 20.801 0 0 1-.5 1.05zm2.446.45c.15.163.296.3.435.41.24.19.407.253.498.256a.107.107 0 0 0 .07-.015.307.307 0 0 0 .094-.125.436.436 0 0 0 .059-.2.095.095 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a3.876 3.876 0 0 0-.612-.053zM8.078 7.8a6.7 6.7 0 0 0 .2-.828c.031-.188.043-.343.038-.465a.613.613 0 0 0-.032-.198.517.517 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822.024.111.054.227.09.346z"/>
          </svg>
          Export as PDF
        </a>
      </div>
      <h1>Distributor Application Detail <span style="font-family:monospace;font-size:1rem;font-weight:700;color:#293C95;background:#EEF1FB;padding:3px 10px;border-radius:6px;vertical-align:middle">DA-<%= application._id.toString().slice(-6).toUpperCase() %></span></h1>

      <div class="detail-card">
        <h2>Status <span class="status-badge status-<%= application.status %>"><%= application.status.replace('_', ' ') %></span></h2>
        <form action="/admin/distributor-applications/<%= application._id %>/status" method="POST" class="status-form">
          <select name="status" class="status-select">
            <option value="new"          <%= application.status === 'new'          ? 'selected' : '' %>>New</option>
            <option value="under_review" <%= application.status === 'under_review' ? 'selected' : '' %>>Under Review</option>
            <option value="accepted"     <%= application.status === 'accepted'     ? 'selected' : '' %>>Accepted</option>
            <option value="rejected"     <%= application.status === 'rejected'     ? 'selected' : '' %>>Rejected</option>
          </select>
          <button type="submit" class="status-btn">Update Status</button>
        </form>
      </div>

      <!-- Company Information -->
      <div class="detail-card">
        <h2>Company Information</h2>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Company</div><div class="detail-value"><%= application.companyName %></div></div>
          <div class="detail-field"><div class="detail-label">Country</div><div class="detail-value"><%= application.country %></div></div>
          <div class="detail-field"><div class="detail-label">Website</div><div class="detail-value"><% if (application.website) { %><a href="<%= application.website %>" target="_blank"><%= application.website %></a><% } else { %>—<% } %></div></div>
        </div>
        <% if (application.companyOverview) { %>
        <div class="detail-row">
          <div class="detail-field" style="flex:1 1 100%">
            <div class="detail-label">Company Overview</div>
            <div class="detail-value"><%= application.companyOverview %></div>
          </div>
        </div>
        <% } %>
      </div>

      <!-- Business & Distribution Capability -->
      <div class="detail-card">
        <h2>📊 Business & Distribution Capability</h2>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Company Established</div><div class="detail-value"><%= application.companyEstablished || '—' %></div></div>
          <div class="detail-field"><div class="detail-label">Annual Sales Volume</div><div class="detail-value"><%= application.annualSalesVolume || '—' %></div></div>
          <div class="detail-field"><div class="detail-label">Current Brands</div><div class="detail-value"><%= application.currentBrands || '—' %></div></div>
        </div>
        <% if (application.industryFocus) { %>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Industry Focus</div><div class="detail-value"><%= application.industryFocus %></div></div>
        </div>
        <% } %>
        <% if (application.salesChannels) { %>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Sales Channels</div><div class="detail-value"><%= application.salesChannels %></div></div>
        </div>
        <% } %>
      </div>

      <!-- Market & Territory -->
      <div class="detail-card">
        <h2>🌍 Market & Territory</h2>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Distribution Territory</div><div class="detail-value"><%= application.distributionTerritory || '—' %></div></div>
          <div class="detail-field"><div class="detail-label">Target Market</div><div class="detail-value"><%= application.targetMarket || '—' %></div></div>
        </div>
      </div>

      <!-- Supporting Documents -->
      <% if (application.companyProfileUrl) { %>
      <div class="detail-card">
        <h2>📎 Supporting Documents</h2>
        <div class="detail-row">
          <div class="detail-field">
            <div class="detail-label">Company Profile / Brochure</div>
            <div class="detail-value"><a href="<%= application.companyProfileUrl %>" target="_blank" rel="noopener">View / Download</a></div>
          </div>
        </div>
      </div>
      <% } %>

      <div class="detail-card">
        <h2>Contact Information</h2>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Contact Name</div><div class="detail-value"><%= application.contactName %></div></div>
          <div class="detail-field"><div class="detail-label">Email</div><div class="detail-value"><a href="mailto:<%= application.email %>"><%= application.email %></a></div></div>
          <div class="detail-field"><div class="detail-label">Phone</div><div class="detail-value"><%= application.phone || '—' %></div></div>
        </div>
        <div class="detail-row">
          <div class="detail-field"><div class="detail-label">Language</div><div class="detail-value"><%= application.lang %></div></div>
          <div class="detail-field"><div class="detail-label">Submitted</div><div class="detail-value"><%= new Date(application.createdAt).toLocaleString() %></div></div>
        </div>
      </div>
    </div>
  </section>
</body>
