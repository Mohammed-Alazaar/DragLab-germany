<%- include('../../includes/sellercompany/head.ejs') %>
<link rel="stylesheet" href="/css/sellercompany/all-technical-service.css">

<style nonce="<%= nonce %>">
  .form-card { background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 2rem; }
  .form-group { margin-bottom: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .form-group label { font-size: 0.87rem; font-weight: 700; color: #2c3e50; }
  .form-group input, .form-group select, .form-group textarea {
    padding: 0.6rem 0.9rem; border: 1.5px solid #dee2e6; border-radius: 6px; font-size: 0.93rem;
    width: 100%; box-sizing: border-box; font-family: inherit; color: #2c3e50;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none; border-color: #0d3b6e;
  }
  .form-group textarea { min-height: 120px; resize: vertical; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
  @media (max-width: 700px) { .form-row, .form-row-3 { grid-template-columns: 1fr; } }
  .lang-tabs { display: flex; gap: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #dee2e6; }
  .lang-tab { padding: 0.6rem 1.2rem; cursor: pointer; font-weight: 700; font-size: 0.88rem; color: #7f8c8d; border: none; background: none; border-bottom: 3px solid transparent; margin-bottom: -2px; }
  .lang-tab.active { color: #0d3b6e; border-bottom-color: #0d3b6e; }
  .lang-panel { display: none; }
  .lang-panel.active { display: block; }
  .section-heading { font-size: 1rem; font-weight: 700; color: #0d3b6e; margin: 1.5rem 0 0.8rem; padding-bottom: 0.3rem; border-bottom: 1px solid #e4e8ef; }
  .submit-btn { padding: 0.75rem 2.5rem; background: #0d3b6e; color: #fff; border: none; border-radius: 6px; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 1.5rem; }
  .submit-btn:hover { background: #c9a227; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: #0d3b6e; font-weight: 600; text-decoration: none; }
</style>

<body>
  <%- include('../../includes/sellercompany/navbar-dash.ejs') %>

  <section class="sidebar-content-container">
    <section class="sidebar-container">
      <%- include('../../includes/sellercompany/sidebar.ejs') %>
    </section>

    <div class="article-dashboard-container">
      <a href="/admin/case-studies" class="back-link">← Back to Case Studies</a>
      <h1><%= editing ? 'Edit Case Study' : 'Add New Case Study' %></h1>

      <div class="form-card">
        <form action="<%= editing ? '/admin/case-studies/edit/' + caseStudy._id : '/admin/case-studies/add' %>" method="POST">

          <!-- Global Fields -->
          <div class="section-heading">General Information</div>
          <div class="form-row">
            <div class="form-group">
              <label>Global Slug (auto-generated if empty)</label>
              <input type="text" name="slug" value="<%= editing && caseStudy ? caseStudy.slug || '' : '' %>">
            </div>
            <div class="form-group">
              <label>Status</label>
              <select name="status">
                <option value="draft"     <%= (editing && caseStudy && caseStudy.status === 'draft')     ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= (editing && caseStudy && caseStudy.status === 'published') ? 'selected' : '' %>>Published</option>
              </select>
            </div>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label>Client Type</label>
              <input type="text" name="clientType" value="<%= editing && caseStudy ? caseStudy.clientType || '' : '' %>" placeholder="e.g. Research Lab">
            </div>
            <div class="form-group">
              <label>Client Location</label>
              <input type="text" name="clientLocation" value="<%= editing && caseStudy ? caseStudy.clientLocation || '' : '' %>" placeholder="e.g. Germany">
            </div>
            <div class="form-group">
              <label>Client Size</label>
              <input type="text" name="clientSize" value="<%= editing && caseStudy ? caseStudy.clientSize || '' : '' %>" placeholder="e.g. 50-200 employees">
            </div>
          </div>
          <div class="form-group">
            <label>Industry</label>
            <input type="text" name="industry" value="<%= editing && caseStudy ? caseStudy.industry || '' : '' %>" placeholder="e.g. Pharmaceutical">
          </div>

          <!-- Language Tabs -->
          <div class="section-heading">Translations</div>
          <div class="lang-tabs">
            <% ['en','es','de','tr','fr'].forEach((l, idx) => { %>
            <button type="button" class="lang-tab <%= idx === 0 ? 'active' : '' %>" data-tab="tab-<%= l %>"><%= l.toUpperCase() %></button>
            <% }) %>
          </div>

          <% ['en','es','de','tr','fr'].forEach((l, idx) => {
             const tr = (editing && caseStudy && caseStudy.translations && caseStudy.translations[l]) ? caseStudy.translations[l] : {};
          %>
          <div class="lang-panel <%= idx === 0 ? 'active' : '' %>" id="tab-<%= l %>">
            <div class="form-group">
              <label>Title (<%= l.toUpperCase() %>)</label>
              <input type="text" name="title_<%= l %>" value="<%= tr.title || '' %>">
            </div>
            <div class="form-group">
              <label>Slug (<%= l.toUpperCase() %>, auto-generated if empty)</label>
              <input type="text" name="slug_<%= l %>" value="<%= tr.slug || '' %>">
            </div>
            <div class="form-group">
              <label>Summary (<%= l.toUpperCase() %>) – shown on listing page</label>
              <textarea name="summary_<%= l %>"><%= tr.summary || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Client Profile (<%= l.toUpperCase() %>)</label>
              <textarea name="clientProfile_<%= l %>"><%= tr.clientProfile || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Problem / Challenge (<%= l.toUpperCase() %>)</label>
              <textarea name="problem_<%= l %>"><%= tr.problem || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Solution (<%= l.toUpperCase() %>)</label>
              <textarea name="solution_<%= l %>"><%= tr.solution || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Results (<%= l.toUpperCase() %>)</label>
              <textarea name="results_<%= l %>"><%= tr.results || '' %></textarea>
            </div>
            <div class="form-group">
              <label>Status (<%= l.toUpperCase() %>)</label>
              <select name="status_<%= l %>">
                <option value="draft"     <%= (tr.status === 'draft'     || !tr.status) ? 'selected' : '' %>>Draft</option>
                <option value="published" <%= tr.status === 'published'               ? 'selected' : '' %>>Published</option>
              </select>
            </div>
          </div>
          <% }) %>

          <button type="submit" class="submit-btn"><%= editing ? 'Save Changes' : 'Add Case Study' %></button>
        </form>
      </div>
    </div>
  </section>

  <script nonce="<%= nonce %>">
  (function() {
    document.querySelectorAll('.lang-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.lang-tab').forEach(function(t) { t.classList.remove('active'); });
        document.querySelectorAll('.lang-panel').forEach(function(p) { p.classList.remove('active'); });
        this.classList.add('active');
        document.getElementById(this.dataset.tab).classList.add('active');
      });
    });
  })();
  </script>
</body>
