<%- include('../../includes/sellercompany/head.ejs') %>
<link rel="stylesheet" href="/css/sellercompany/all-technical-service.css">

<style>
  .badge-role {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .badge-admin { background: #e8f0fe; color: #1a56db; }
  .badge-subadmin { background: #f0fdf4; color: #166534; }

  .btn-edit {
    background: var(--primary-Color, #1a56db);
    color: #fff;
    padding: 5px 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.83rem;
    text-decoration: none;
    display: inline-block;
  }
  .btn-edit:hover { opacity: 0.88; }

  .btn-delete {
    background: #dc3545; color: #fff;
    border: none; padding: 5px 12px; border-radius: 4px;
    cursor: pointer; font-size: 0.83rem; font-weight: 600;
  }
  .btn-delete:hover { background: #b02a37; }
  .btn-delete:disabled { background: #aaa; cursor: not-allowed; }

  .page-actions { margin-bottom: 20px; }
  .btn-add-user {
    background: var(--primary-Color, #1a56db);
    color: #fff; padding: 9px 20px; border-radius: 6px;
    text-decoration: none; font-weight: 600; font-size: 0.93rem;
  }
  .btn-add-user:hover { opacity: 0.88; }

  .alert { padding: 12px 18px; border-radius: 6px; margin-bottom: 16px; font-size: 0.93rem; }
  .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
  .alert-error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

  .you-badge {
    display: inline-block;
    background: #e0e7ff; color: #3730a3;
    font-size: 0.68rem; font-weight: 700;
    padding: 1px 7px; border-radius: 10px;
    margin-left: 5px; vertical-align: middle;
  }

  /* Delete modal */
  #delete-modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.5); z-index: 9999;
    align-items: center; justify-content: center;
  }
  #delete-modal.open { display: flex; }
  .modal-card {
    background: #fff; border-radius: 12px;
    padding: 36px 32px 28px; max-width: 400px;
    width: 90%; text-align: center;
    box-shadow: 0 12px 40px rgba(0,0,0,0.2);
  }
  .modal-card .modal-icon { font-size: 2.4rem; margin-bottom: 12px; }
  .modal-card h3 { margin: 0 0 8px; font-size: 1.2rem; color: #1a1a1a; }
  .modal-card p { margin: 0 0 24px; color: #555; font-size: 0.93rem; line-height: 1.5; }
  .modal-card p strong { color: #1a1a1a; }
  .modal-buttons { display: flex; gap: 12px; justify-content: center; }
  .modal-btn-cancel {
    flex: 1; background: #f0f0f0; color: #333;
    border: none; padding: 10px 0; border-radius: 6px;
    cursor: pointer; font-size: 0.95rem; font-weight: 600;
  }
  .modal-btn-cancel:hover { background: #ddd; }
  .modal-btn-confirm {
    flex: 1; background: #dc3545; color: #fff;
    border: none; padding: 10px 0; border-radius: 6px;
    cursor: pointer; font-size: 0.95rem; font-weight: 600;
  }
  .modal-btn-confirm:hover { background: #b02a37; }
</style>

</head>

<body>
  <%- include('../../includes/sellercompany/navbar-dash.ejs') %>
  <section class="sidebar-content-container">
    <section class="sidebar-container">
      <%- include('../../includes/sellercompany/sidebar.ejs') %>
    </section>

    <section class="content-container">
      <h1>User Management</h1>

      <% if (successMessage) { %>
        <div class="alert alert-success"><%= successMessage %></div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="alert alert-error"><%= errorMessage %></div>
      <% } %>

      <div class="page-actions">
        <a href="/admin/users/add" class="btn-add-user">+ Add New User</a>
      </div>

      <% if (users.length === 0) { %>
        <p>No users found.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u, i) { %>
              <tr>
                <td><%= (currentPage - 1) * 20 + i + 1 %></td>
                <td>
                  <%= u.name %>
                  <% if (u._id.toString() === currentUserId) { %>
                    <span class="you-badge">YOU</span>
                  <% } %>
                </td>
                <td><%= u.email %></td>
                <td><%= u.phoneNumber %></td>
                <td>
                  <span class="badge-role <%= u.role === 'admin' ? 'badge-admin' : 'badge-subadmin' %>">
                    <%= u.role === 'admin' ? 'Admin' : 'Sub Admin' %>
                  </span>
                </td>
                <td>
                  <a href="/admin/users/edit/<%= u._id %>" class="btn-edit">Edit</a>

                  <% if (u._id.toString() !== currentUserId) { %>
                    <form method="POST" action="/admin/users/delete/<%= u._id %>" style="display:inline;"
                          class="delete-form" data-name="<%= u.name %>">
                      <button type="submit" class="btn-delete">Delete</button>
                    </form>
                  <% } else { %>
                    <button class="btn-delete" disabled title="Cannot delete your own account">Delete</button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
      <%- include('../../includes/sellercompany/pagination.ejs') %>
    </section>
  </section>

  <!-- Delete confirmation modal -->
  <div id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-card">
      <div class="modal-icon">🗑️</div>
      <h3 id="modal-title">Delete User?</h3>
      <p id="modal-body">This action is permanent and cannot be undone.</p>
      <div class="modal-buttons">
        <button id="modal-cancel" class="modal-btn-cancel">Cancel</button>
        <button id="modal-confirm" class="modal-btn-confirm">Yes, Delete</button>
      </div>
    </div>
  </div>

  <script nonce="<%= nonce %>">
    (function () {
      var modal       = document.getElementById('delete-modal');
      var modalBody   = document.getElementById('modal-body');
      var btnCancel   = document.getElementById('modal-cancel');
      var btnConfirm  = document.getElementById('modal-confirm');
      var pendingForm = null;

      function openModal(name, form) {
        pendingForm = form;
        modalBody.innerHTML = 'You are about to permanently delete user <strong>' + name + '</strong>.<br>This cannot be undone.';
        modal.classList.add('open');
      }

      function closeModal() {
        modal.classList.remove('open');
        pendingForm = null;
      }

      document.querySelectorAll('.delete-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          openModal(form.dataset.name, form);
        });
      });

      btnCancel.addEventListener('click', closeModal);
      btnConfirm.addEventListener('click', function () { if (pendingForm) pendingForm.submit(); });
      modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
    })();
  </script>
</body>
</html>
