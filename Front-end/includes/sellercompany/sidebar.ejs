<div class="sidebar-side">
        <a class="<%= path === '/admin/Dashboard' ? 'selected' : '' %>" href="/admin/dashboard"><img src="/assets/Imgs/Icons/Dashboard-icon.png" width="35px" alt="">Dashboard</a>
        <a class="<%= path === '/admin/Myproduct' || path === '/admin/add-product' || path === '/admin/edit-product' ? 'selected' : '' %>" href="/admin/Myproduct"><img src="/assets/Imgs/Icons/basket.png" width="35px" alt="">Products</a>
        <a class="<%= path === '/admin/contact-messages' || path.startsWith('/admin/contact-message') ? 'selected' : '' %>" href="/admin/contact-messages"><img src="/assets/Imgs/Icons/contactUs-Messages.png" width="35px" alt="">Contact Messages</a>
        <a class="<%= path === '/admin/quotes' || path.startsWith('/admin/quotes/') ? 'selected' : '' %>" href="/admin/quotes"><img src="/assets/Imgs/Icons/contactUs-Messages.png" width="35px" alt="">Quote Requests</a>
        <a class="<%= path === '/admin/distributor-applications' || path === '/admin/distributor-application-details' ? 'selected' : '' %>" href="/admin/distributor-applications"><img src="/assets/Imgs/Icons/articles.png" width="35px" alt="">Distributor Applications</a>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a class="<%= path === '/admin/users' || path === '/admin/users/add' ? 'selected' : '' %>" href="/admin/users"><img src="/assets/Imgs/Icons/addUser.png" width="35px" alt="">User Management</a>
        <% } %>
        <a class="<%= path === '/admin/account' ? 'selected' : '' %>" href="/admin/account"><img src="/assets/Imgs/Icons/settings-icon.png" width="35px" alt="">Settings</a>
</div>