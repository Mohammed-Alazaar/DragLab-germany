                                : 'Technical Service' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Contactus">
                            <%= lang==='DE' ? 'Kontakt' : lang==='ES' ? 'Contáctanos' : 'Contact Us' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Downloads">
                            <%= lang==='DE' ? 'Download-Center' : lang==='ES' ? 'Centro de Descargas'
