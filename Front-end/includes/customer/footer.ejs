                        </a>
                    </li>
                    <li><span class="highlighted">
                            <%= lang==='DE' ? 'Telefon:' : lang==='ES' ? 'Teléfono:' : 'Phone :' %>
                        </span> +49 6196 400816</li>
                    <li><span class="highlighted">
                            <%= lang==='DE' ? 'Fax:' : lang==='ES' ? 'Fax:' : 'Fax :' %>
                        </span> +49 6196 400910</li>
                    <li><span class="highlighted">
                            <%= lang==='DE' ? 'E-Mail:' : lang==='ES' ? 'Correo electrónico:' : 'Email:' %>
                        </span>
                        <a href="mailto:info@drag-lab.de">info@drag-lab.de</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-legal">
            <a href="/<%= lang %>/PrivacyPolicy">
                <%= lang==='DE' ? 'Datenschutzerklärung' : lang==='ES' ? 'Política de Privacidad' : 'Privacy Policy' %>
            </a>
            | <a href="#" id="open_preferences_center">
                <%= lang==='DE' ? 'Cookie-Einstellungen aktualisieren' : lang==='ES'
                    ? 'Actualizar preferencias de cookies' : 'Update cookies preferences' %>
            </a>
            | <a href="/<%= lang %>/TermCondition">
                <%= lang==='DE' ? 'Allgemeine Geschäftsbedingungen' : lang==='ES' ? 'Términos y Condiciones'
