<footer class="footer">

    <div class="newsletter-banner">
        <div class="newsletter-content">
            <h2>Join our newsletter to stay up to date on new releases</h2>

        </div>
        <div class="newsletter-form">
            <form id="newsletterForm">
                <input type="email" name="email" id="newsletterEmail" placeholder="Enter Your Email" required />
                <input type="hidden" name="language" id="newsletterLang" value="<%= lang %>" />
                <button type="submit">Submit</button>
            </form>

            <p id="newsletterMessage" style="margin-top: 10px;"></p>


        </div>
    </div>
    <!-- <div class="footer-newsletter">
        <div class="footer-newsletter-text">
            <p>Join our newsletter to stay up to date on new releases</p>
        </div>
        <div class="footer-newsletter-input">
            <input type="search" placeholder="Enter your email address">    
            <button><%= lang === 'DE' ? 'Abonnieren' : lang === 'ES' ? 'Suscribirse' : 'Subscribe' %></button>
        </div>
    </div> -->
    <div class="footer-container">
        <div class="footer-left">
            <img src="/assets/Imgs/logo/DragLab-Logo.png" alt="DragLab Logo" class="footer-logo">
            <p>
                <%= lang==='DE'
                    ? 'DragLab ist ein Hersteller und globaler Anbieter von allgemeiner Laborausrüstung für Forschungseinrichtungen, industrielle Labore und Gesundheitseinrichtungen. Unsere Produkte sind darauf ausgelegt, Laborexperten mit Präzision und Zuverlässigkeit zu unterstützen.'
                    : lang==='ES'
                    ? 'DragLab es un fabricante y proveedor global de equipos de laboratorio general para instituciones de investigación, laboratorios industriales y centros de atención médica. Nuestros productos están diseñados para respaldar a los profesionales de laboratorio con precisión y fiabilidad.'
                    : 'DragLab is a manufacturer and global supplier of general laboratory equipment for research institutions, industrial laboratories, and healthcare facilities. Our products are designed to support laboratory professionals with precision and reliability.'
                    %>
            </p>
        </div>

        <div class="footer-links">
            <div class="footer-column">
                <h4>
                    <%= lang==='DE' ? 'Neuigkeiten & Veranstaltungen' : lang==='ES' ? 'Noticias y Eventos'
                        : 'News & Events' %>
                </h4>
                <ul>
                    <li><a href="/<%= lang %>/Articles">
                            <%= lang==='DE' ? 'Neuigkeiten' : lang==='ES' ? 'Noticias' : 'News' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Articles">
                            <%= lang==='DE' ? 'Artikel' : lang==='ES' ? 'Artículos' : 'Articles' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Articles">
                            <%= lang==='DE' ? 'Veranstaltungen' : lang==='ES' ? 'Eventos' : 'Events' %>
                        </a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h4>
                    <%= lang==='DE' ? 'Über Uns' : lang==='ES' ? 'Sobre Nosotros' : 'About Us' %>
                </h4>
                <ul>
                    <li><a href="/<%= lang %>/quality-policy">
                            <%= lang==='DE' ? 'Qualitätspolitik' : lang==='ES' ? 'Política de Calidad'
                                : 'Quality Policy' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Downloads">
                            <%= lang==='DE' ? 'Zertifikate' : lang==='ES' ? 'Certificados' : 'Certificates' %>
                        </a></li>
                    <li><a href="/<%= lang %>/aboutus">
                            <%= lang==='DE' ? 'Über Uns' : lang==='ES' ? 'Sobre Nosotros' : 'About Us' %>
                        </a></li>
