            <a href="https://www.youtube.com/channel/UC5TffQfcaIONbKBBxKpyxag"><img
                    src="/assets/Imgs/Icons/products/youtube.png" alt="YouTube"></a>
        </div>
        <div class="footer-copy">
            <%= lang==='DE' ? '© Copyright DragLab. Alle Rechte vorbehalten.' : lang==='ES'
                ? '© Copyright DragLab. Todos los derechos reservados.' : '© Copyright DragLab. All Rights Reserved' %>
