                        </a></li>
                </ul>
            </div>

            <div class="footer-column contactusFooter">
                <h4>
                    <%= lang==='DE' ? 'Kontakt' : lang==='ES' ? 'Contáctanos' : 'Contact Us' %>
                </h4>
                <ul>
                    <li><span class="highlighted">
