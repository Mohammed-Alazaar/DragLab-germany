  "url": faqSchema[lang].url,
  "mainEntity": faqSchema[lang].questions.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
}, null, 2) %>
