<!DOCTYPE html>
<html lang="<%= lang.toLowerCase() %>">

<head>
  <link rel="stylesheet" href="/css/reset-code.css">
  <link rel="stylesheet" href="/css/nav-bar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <script src="/js/navbar.js" defer></script>
  <script nonce="<%= nonce %>">
    // Load cookie UI after idle so it never competes with LCP
    (window.requestIdleCallback || function (cb) { return setTimeout(cb, 1200); })(function () {
      var s = document.createElement('script');
      s.src = "https://www.termsfeed.com/public/cookie-consent/4.2.0/cookie-consent.js";
      s.defer = true;
      s.setAttribute('nonce', "<%= nonce %>");
      document.head.appendChild(s);
    });
  </script>

  <script src="/js/termsfeed-init.js" defer nonce="<%= nonce %>"></script>
  <script type="text/plain" data-cookie-consent="strictly-necessary" src="/js/tawkto-init.js" defer></script>
  <!-- In your head.ejs -->
  <script src="/js/clarity.js" defer nonce="<%= nonce %>"></script>
  <script type="text/plain" data-cookie-consent="tracking" async
    src="https://www.googletagmanager.com/gtag/js?id=G-6HXYVZ8CMN"></script>
  <script type="text/plain" data-cookie-consent="tracking" src="/js/gtag-config.js" defer></script>
  <link rel="icon" href="/assets/Imgs/logo/favicon.ico">
  <link rel="icon" href="/assets/Imgs/logo/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/assets/Imgs/logo/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/Imgs/logo/favicon-180.png" sizes="180x180">
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#005bac">
  <meta name="author" content="DragLab">
  <meta name="twitter:site" content="@DraglabGermany">
  <meta property="og:locale" content="<%= lang === 'EN' ? 'en_US' : lang === 'ES' ? 'es_ES' : 'de_DE' %>">

  <% const metaKeywords={
    EN: "DragLab, laboratory equipment, medical equipment, incubators, ovens, distillers, water baths, drying ovens, quality policy, privacy policy, code of ethics, terms and conditions, contact us, technical service, warranty registration, download center, multilingual support, global distribution, ISO certified, CE compliant, quality assurance, customer support, research equipment, healthcare devices, lab technology, lab instruments, medical instruments, scientific equipment, biotech equipment, lab solutions, medical supplies, laboratory solutions provider"
    ,
    ES: "DragLab, equipos de laboratorio, equipos médicos, incubadoras, hornos, destiladores, baños maría, hornos de secado, política de calidad, política de privacidad, código de ética, términos y condiciones, contáctenos, servicio técnico, registro de garantía, centro de descargas, soporte multilingüe, distribución global, certificado ISO, cumplimiento CE, aseguramiento de calidad, atención al cliente, equipos de investigación, dispositivos médicos, tecnología de laboratorio, instrumentos médicos, instrumentos científicos, soluciones de laboratorio, proveedor de soluciones médicas"
    ,
    DE: "DragLab, Laborausrüstung, medizinische Geräte, Inkubatoren, Öfen, Destillierer, Wasserbäder, Trockenschränke, Qualitätspolitik, Datenschutzrichtlinie, Ethikkodex, Allgemeine Geschäftsbedingungen, Kontakt, technischer Support, Garantieanmeldung, Download-Center, mehrsprachiger Support, weltweiter Vertrieb, ISO-zertifiziert, CE-konform, Qualitätssicherung, Kundenservice, Forschungsausrüstung, medizinische Lösungen, Labortechnologie, medizinische Instrumente, wissenschaftliche Geräte, Laborbedarf, Anbieter von Laborausrüstung"
    }; %>
    <meta name="keywords" content="<%= metaKeywords[lang] %>">
    <!-- speed up 3rd-party requests -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="preconnect" href="https://embed.tawk.to" crossorigin>
    <!-- speed up 3rd-party requests -->
    <%- include('./faqSchema.ejs', { lang, faqSchema }) %>
      <!-- FAQ Schema (JSON-LD Structured Data) For the SEO -->
      <% const sameAsLinks=[ "https://www.linkedin.com/company/draglab-technologies"
        , "https://www.facebook.com/draglabde/" , "https://www.youtube.com/channel/UC5TffQfcaIONbKBBxKpyxag" ]; %>

        <!-- Organization / Brand Logo (square) -->
        <script type="application/ld+json" nonce="<%= nonce %>">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DragLab",
  "url": "https://www.drag-lab.de/",
  "logo": "https://www.drag-lab.de/assets/Imgs/logo/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/draglab-technologies",
    "https://www.facebook.com/draglabde/",
    "https://www.youtube.com/channel/UC5TffQfcaIONbKBBxKpyxag"
  ]
}
</script>

        <link rel="alternate" type="application/rss+xml" title="DragLab Articles (EN)"
          href="https://www.drag-lab.de/EN/feed.xml">
        <link rel="alternate" type="application/rss+xml" title="DragLab Articles (ES)"
          href="https://www.drag-lab.de/ES/feed.xml">
        <link rel="alternate" type="application/rss+xml" title="DragLab Articles (DE)"
          href="https://www.drag-lab.de/DE/feed.xml">


        <style nonce="<%= nonce %>">
          /* Keep the banner out of viewport & clicks until we explicitly show it */
          #cc--main,
          #cc--main .cc-window {
            pointer-events: none;
          }

          #cc--main .cc-window {
            position: fixed !important;
            left: 50% !important;
            bottom: 16px !important;
            transform: translate(-50%, 200%);
            /* off-screen */
            transition: transform .25s ease;
            z-index: 2147483647 !important;
            max-width: 680px !important;
            width: calc(100% - 32px) !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .15);
            border-radius: 12px;
            visibility: hidden;
            /* not paintable -> not a candidate for LCP */
          }

          .cookie-ready #cc--main,
          .cookie-ready #cc--main .cc-window {
            pointer-events: auto;
          }

          .cookie-ready #cc--main .cc-window {
            transform: translate(-50%, 0);
            visibility: visible;
            /* show only after idle init */
          }

          /* Mobile tweak */
          @media (max-width:480px) {
            #cc--main .cc-window {
              max-width: 560px !important;
              border-radius: 10px;
            }
          }
        </style>

        <!-- Preload the actual hero image that becomes LCP -->
        <link rel="preload" as="image" href="/assets/hero/hero@1x.webp"
          imagesrcset="/assets/hero/hero@1x.webp 1x, /assets/hero/hero@2x.webp 2x" fetchpriority="high">

        <% if (typeof slides !=='undefined' && slides.length && slides[0].image) { %>
          <link rel="preload" as="image" href="<%= slides[0].image %>" fetchpriority="high">
          <% } %>