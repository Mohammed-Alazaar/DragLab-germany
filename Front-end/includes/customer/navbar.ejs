<div id="cc--main" role="dialog" aria-hidden="true" data-nosnippet></div>

<div class="navbarContainer">
    <div class="navright">
        <a href="/">
            <img src="/assets/Imgs/logo/DragLab-Logo.png" alt="DragLab Logo">
        </a>
    </div>


    <div class="navMid">
        <div class="12">

            <ul class="menu">
                <li class="dropdown">
                    <p>
                    <p>
                        <%= lang==='DE' ? 'Unternehmen' : lang==='ES' ? 'Empresa' : 'Company' %>
                            <img src="/assets/Imgs/Icons/Down-arrow-blue.png" alt="Down arrow">
                    </p>

                    </p>
                    <ul class="dropdown-menu">
                        <li><a href="/aboutus">&#8226; <%= lang==='DE' ? 'Über Uns' : lang==='ES' ? 'Sobre Nosotros'
                                    : 'About Us' %></a></li>
                        <li><a href="/<%= lang %>/QualityPolicy">&#8226; <%= lang==='DE' ? 'Qualitätspolitik' :
                                    lang==='ES' ? 'Política de Calidad' : 'Quality Policy' %></a></li>
                        <li><a href="/<%= lang %>/SustainabilityPolicy">&#8226; <%= lang==='DE' ? 'Nachhaltigkeit' :
                                    lang==='ES' ? 'Sostenibilidad' : 'Sustainability' %></a></li>
                        <li><a href="/<%= lang %>/Qualifications">&#8226; <%= lang==='DE' ? 'Qualifikationen' :
                                    lang==='ES' ? 'Calificaciones' : 'Qualifications' %></a></li>
                        <li><a href="/<%= lang %>/PrivacyPolicy">&#8226; <%= lang==='DE' ? 'Datenschutzerklärung' :
                                    lang==='ES' ? 'Política de Privacidad' : 'Privacy Policy' %></a></li>

                        <!-- <li><a href="/imprint">&#8226; <%= lang==='DE' ? 'Impressum' : lang==='ES'
                                    ? 'Impreso' : 'Imprint' %></a></li> -->

                    </ul>
                </li>

                <li class="dropdown">
                    <p>
                    <p>
                        <%= lang==='DE' ? 'Produkte' : lang==='ES' ? 'Productos' : 'Products' %>
                            <img src="/assets/Imgs/Icons/Down-arrow-blue.png" alt="Down arrow">
                    </p>

                    </p>
                    <ul class="dropdown-menu dropdown-menu-products">
                        <div class="ProductsDivContainer">
                            <div class="AllproductContainer">
                                <p>Products</p>

                                <% products.filter(p=> !p.isDraft).forEach(product => {

                                    const productLang = product.Language?.[lang]?.[0];
                                    const modelsArray = product.Models
                                    .filter(model => model.isPublished)
                                    .map(model => {
                                    return {
                                    id: model.slug,
                                    name: model.Language?.[lang]?.[0]?.ModelName || model.Language?.EN?.[0]?.ModelName
                                    };
                                    });


                                    %>
                                    <div class="productContainer" data-goto-product="<%= product.slug %>"
                                        data-update-models="<%= product.slug %>" data-id="<%= product.slug %>"
                                        data-sketch="<%= product.ProductSketch %>"
                                        data-models='<%- JSON.stringify(modelsArray) %>'>

                                        <div class="productphotoContainer">
                                            <img src="<%=product.ProductSketch %>" width="80.1px" alt="">
                                        </div>

                                        <div class="productNamImgContainer">
                                            <div class="productnameContainer">
                                                <h2>
                                                    <%= productLang?.ProductName %>
                                                </h2>
                                                <p>
                                                    <%= productLang?.ProductNameDesc %>
                                                </p>
                                            </div>
                                            <img src="/assets/Imgs/Icons/Arrow.png" alt="arrow">
                                        </div>
                                    </div>
                                    <% }); %>

                            </div>

                            <div class="modelsContainer">
                                <div class="imgModelContainer">
                                    <img src="/assets/Imgs/Icons/models.png" alt="models" width="38.31px">
                                    <p>models:</p>
                                </div>
                                <ul>
                                    <% products.forEach(product=> {
                                        const productLang = product.Language?.[lang]?.[0];
                                        product.Models.forEach(model => {
                                        const modelLang = model.Language?.[lang]?.[0];

                                        %>
                                        <li>
                                            <%= productLang?.ProductName %> - <%= modelLang?.ModelName %>
                                        </li>
                                        <% })}) %>
                                </ul>
                            </div>

                            <div class="productImgContainer">
                                <img src="/assets/Imgs/Icons/products/waterBath.webp" alt="">
                            </div>
                        </div>
                    </ul>

                </li>

                <li class="dropdown">
                    <p>
                    <p>
                        <%= lang==='DE' ? 'Dienstleistungen' : lang==='ES' ? 'Servicios' : 'Services' %>
                            <img src="/assets/Imgs/Icons/Down-arrow-blue.png" alt="Down arrow">
                    </p>

                    </p>
                    <ul class="dropdown-menu">
                        <li><a href="/<%= lang %>/support">&#8226; <%= lang==='DE' ? 'Support' : lang==='ES' ? 'Soporte'
                                    : 'Support' %></a></li>
                        <li><a href="/<%= lang %>/Downloads">&#8226; <%= lang==='DE' ? 'Downloads' : lang==='ES'
                                    ? 'Descargas' : 'Downloads' %></a></li>
                        <li><a href="/industry">&#8226; <%= lang==='DE' ? 'Branche & Anwendungen' : lang==='ES'
                                    ? 'Industria & Aplicaciones' : 'Industries & Applications' %></a></li>
                        <li><a href="/<%= lang %>/technical-service">&#8226; <%= lang==='DE' ? 'Technischer Service' :
                                    lang==='ES' ? 'Servicio Técnico' : 'Technical Services' %></a></li>
                        <li><a href="/<%= lang %>/WarrantyRegistration">&#8226; <%= lang==='DE'
                                    ? 'Garantieregistrierung' : lang==='ES' ? 'Registro de Garantía'
                                    : 'Warranty Registration' %></a></li>
                        <li><a href="/TermCondition">&#8226; <%= lang==='DE' ? 'AGB' : lang==='ES'
                                    ? 'Términos y Condiciones' : 'Terms & Condition' %></a></li>


                    </ul>

                </li>
                <li><a href="/<%= lang %>/Articles">
                        <%= lang==='DE' ? 'Artikel' : lang==='ES' ? 'Artículos' : 'Articles' %>
                    </a></li>
                <li><a href="/<%= lang %>/Contactus">
                        <%= lang==='DE' ? 'Kontakt' : lang==='ES' ? 'Contáctanos' : 'Contact Us' %>
                    </a></li>

            </ul>
        </div>
    </div>
    <div id="languageSwitcher" class="language-switcher">
        <button type="button" class="lang-toggle" id="currentLangBtn"><span id="currentLangName">Language</span> <img
                src="/assets/Imgs/Icons/Down-arrow-blue.png" alt="Down arrow"></button>
        <ul class="lang-options">
            <li><button type="button" data-lang="EN">English</button></li>
            <li><button type="button" data-lang="ES">Español</button></li>
            <li><button type="button" data-lang="DE">Deutsch</button></li>
        </ul>
    </div>



    <li class="dropdown language-dropdown-mobile">
        <p>
            <%= lang==='DE' ? 'Sprache' : lang==='ES' ? 'Idioma' : 'Language' %>
                <img src="/assets/Imgs/Icons/Down-arrow-blue.png" alt="Down arrow">
        </p>
        <ul class="dropdown-menu">
            <li><a href="javascript:void(0)" onclick="changeLanguage('EN')">&#8226; English</a></li>
            <li><a href="javascript:void(0)" onclick="changeLanguage('ES')">&#8226; Español</a></li>
            <li><a href="javascript:void(0)" onclick="changeLanguage('DE')">&#8226; Deutsch</a></li>
        </ul>
    </li>



    <div class="navLeft">
        <div class="navMidRight">
            <input type="text" id="search" name="search" placeholder="Search..">
            <img src="/assets/Imgs/Icons/search.png" alt="search" class="search-icon">

        </div>
        <div id="searchResults" class="search-results"></div>

    </div>



    <div class="hamburgerIconcontainer">
        <img src="/assets/Imgs/Icons/hamburger-menu.png" alt="menu" id="hamburgerBtn" class="menu-icon" />
    </div>


</div>

</nav>

