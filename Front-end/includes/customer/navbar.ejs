                        <%= lang==='DE' ? 'Dienstleistungen' : lang==='ES' ? 'Servicios' : 'Services' %>
                    </span>
                    <span class="close-menu">&#10005;</span>
                </div>
                <ul>
                    <li><a href="/<%= lang %>/support">
                            <%= lang==='DE' ? 'Support' : lang==='ES' ? 'Soporte' : 'Support' %>
                        </a></li>
                    <li><a href="/<%= lang %>/Downloads">
                            <%= lang==='DE' ? 'Downloads' : lang==='ES' ? 'Descargas' : 'Downloads' %>
                        </a></li>
                    <li><a href="/industry">
                            <%= lang==='DE' ? 'Branche & Anwendungen' : lang==='ES' ? 'Industria & Aplicaciones'
                                : 'Industries & Applications' %>
                        </a></li>
                    <li><a href="/<%= lang %>/technical-service">
                            <%= lang==='DE' ? 'Technischer Service' : lang==='ES' ? 'Servicio Técnico'
                                : 'Technical Services' %>
                        </a></li>
                    <li><a href="/<%= lang %>/WarrantyRegistration">
                            <%= lang==='DE' ? 'Garantieregistrierung' : lang==='ES' ? 'Registro de Garantía'
                                : 'Warranty Registration' %>
                        </a></li>
                    <li><a href="/TermCondition">
                            <%= lang==='DE' ? 'AGB' : lang==='ES' ? 'Términos y Condiciones' : 'Terms & Condition' %>
                        </a></li>



                </ul>
            </div>
            <div class="menu-page" id="languagePage">
                <div class="top-bar">
                    <span class="back" data-go-back-parent>
                        <img src="/assets/Imgs/Icons/backarrow.png" alt="Back" />
                    </span>
                    <span class="page-title">
                        <%= lang==='DE' ? 'Sprache' : lang==='ES' ? 'Idioma' : 'Language' %>
                    </span>
                    <span class="close-menu">&#10005;</span>
                </div>

                <ul>
                    <li><a href="javascript:void(0)" data-lang="EN">English</a></li>
                    <li><a href="javascript:void(0)" data-lang="ES">Español</a></li>
                    <li><a href="javascript:void(0)" data-lang="DE">Deutsch</a></li>
                </ul>
            </div>

</div>