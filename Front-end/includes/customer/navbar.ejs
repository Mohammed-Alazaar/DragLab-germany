            <li><a href="/<%= lang %>/TermCondition">
                    <%= lang==='DE' ? 'AGB' : lang==='ES' ? 'Términos y Condiciones' : 'Terms & Condition' %>
                </a></li>
            <li><a href="/<%= lang %>/QualityPolicy">
                    <%= lang==='DE' ? 'Qualitätspolitik' : lang==='ES' ? 'Política de Calidad' : 'Quality Policy' %>
                </a></li>
            <li><a href="/<%= lang %>/SustainabilityPolicy">
                    <%= lang==='DE' ? 'Nachhaltigkeit' : lang==='ES' ? 'Sostenibilidad' : 'Sustainability' %>
                </a></li>
            <li><a href="/<%= lang %>/Qualifications">
                    <%= lang==='DE' ? 'Qualifikationen' : lang==='ES' ? 'Calificaciones' : 'Qualifications' %>
                </a></li>
            <li><a href="/<%= lang %>/PrivacyPolicy">
                    <%= lang==='DE' ? 'Datenschutzerklärung' : lang==='ES' ? 'Política de Privacidad' : 'Privacy Policy'
                        %>
                </a></li>
        </ul>
    </div>

    <!-- Products Submenu -->
    <!-- Products Menu (no redirect on click) -->
    <!-- Products list page -->
    <div class="menu-page" id="productPage">
        <div class="top-bar">
            <span class="back" data-go-back-parent><img src="/assets/Imgs/Icons/backarrow.png" alt=""></span>
            <span class="page-title">Products</span>
            <span class="close-menu">&#10005;</span>
        </div>

        <% products.filter(p=> !p.isDraft).forEach(product => {
            const productLang = product.Language?.[lang]?.[0];
            %>
            <div class="product-item" data-show-models="<%= product.slug %>">

                <div class="product-photo-container">
                    <img src="<%=product.ProductSketch %>" alt="Product Image" width="80px" height="80px" />
                    <div class="product-info">
                        <h4>
                            <%= productLang?.ProductName %>
                        </h4>
                        <p>
                            <%= productLang?.ProductNameDesc %>
                        </p>
                    </div>
                </div>

                <span class="arrow"><img src="/assets/Imgs/Icons/Arrow.png" alt=""></span>
            </div>
            <% }) %>
    </div>

    <!-- ✅ Move this outside the productPage -->
    <% products.filter(p=> !p.isDraft).forEach(product => {
        const productLang = product.Language?.[lang]?.[0];
        const models = product.Models.filter(m => m.isPublished);
        %>
        <div class="menu-page" id="modelMenu_<%= product.slug %>">
            <div class="top-bar">
                <span class="back" data-go-back="modelMenu_<%= product.slug %>">
                    <img src="/assets/Imgs/Icons/backarrow.png" alt="">
                </span>

                <span class="page-title">Models</span>
                <span class="close-menu">&#10005;</span>
            </div>

            <div class="model-section">
                <div class="imgModelContainer">
                    <img src="/assets/Imgs/Icons/models.png" alt="models" width="30">
                    <p>
                        <%= lang==='DE' ? 'Modelle:' : lang==='ES' ? 'Modelos:' : 'Models:' %>
                    </p>
                </div>

                <ul>
                    <% models.forEach(model=> {
                        const modelLang = model.Language?.[lang]?.[0] || model.Language?.EN?.[0];

                        %>
                        <li data-goto-model-product="<%= product.slug %>" data-goto-model-model="<%= model.slug %>">
                            <%= productLang?.ProductName %> - <%= modelLang?.ModelName %>
                        </li>

                        <% }) %>
                </ul>

                <img src="<%=product.ProductSketch %>" class="model-img" alt="Model Image" />
                <button class="view-product" data-goto-product="<%= product.slug %>">View Product</button>
            </div>
        </div>
        <% }) %>


            <!-- Support Submenu -->
            <div class="menu-page" id="supportPage">
                <div class="top-bar">
                    <span class="back" data-go-back-parent><img src="/assets/Imgs/Icons/backarrow.png" alt=""></span>
