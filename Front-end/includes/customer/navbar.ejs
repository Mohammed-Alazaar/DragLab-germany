            <span class="page-title">
                <%= lang==='DE' ? 'Unternehmen' : lang==='ES' ? 'Empresa' : 'Company' %>
            </span>
            <span class="close-menu">&#10005;</span>
        </div>
        <ul>
            <li><a href="/<%= lang %>/aboutus">
